/* =============================================================================
 * EVO PLAYER PRO - Media Info Specifications RCSS Stylesheet
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Fullscreen Dimmed Scrim */
#mediainfo-scrim {
    width: 1920px;
    height: 1080px;
    background-color: #000000ba;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Media Info Main Card */
#mediainfo-card {
    width: 1400px;
    background-color: #0b101afc;
    border-width: 1px;
    border-color: #1e293b;
    border-radius: 24px;
    padding: 38px 48px;
    display: flex;
    flex-direction: column;
}

/* Header */
#mediainfo-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 1304px;
}

#header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#mediainfo-indicator {
    width: 4px;
    height: 52px;
    background-color: #0070d1;
    border-radius: 2px;
    margin-right: 18px;
}

#header-text-block {
    display: flex;
    flex-direction: column;
    max-width: 980px;
}

#mediainfo-eyebrow {
    font-size: 12px;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1.5px;
}

#mediainfo-title {
    font-size: 26px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-top: 3px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#mediainfo-path {
    font-size: 13px;
    font-weight: normal;
    color: #64748b;
    margin-top: 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#header-badges {
    display: flex;
    flex-direction: row;
    gap: 10px;
    align-items: center;
    flex-shrink: 0;
}

.info-badge {
    background-color: #152033;
    border-width: 1px;
    border-color: #293d5c;
    border-radius: 10px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: bold;
    color: #38bdf8;
    letter-spacing: 0.5px;
}

.badge-hdr {
    border-color: #ffd700;
    color: #ffd700;
}

.badge-hidden {
    display: none;
}

/* Specs Grid */
#specs-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 30px;
    gap: 20px;
    width: 1304px;
}

.spec-card {
    width: 640px;
    background-color: #0f1726d8;
    border-width: 1px;
    border-color: #1c283d;
    border-radius: 16px;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
}

.card-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #1b2638;
    padding-bottom: 10px;
}

.card-icon {
    width: 20px;
    height: 20px;
    display: inline-block;
    margin-right: 10px;
}

.card-title {
    font-size: 14px;
    font-weight: bold;
    color: #e2e8f0;
    letter-spacing: 1px;
}

.spec-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.spec-key {
    font-size: 13px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 0.5px;
    flex-shrink: 0;
    margin-right: 16px;
}

/* Bounded (card is 592 px inside its padding) so long codec strings such as
 * "HEVC (H.265 Main 10)" / "Dolby Digital (E-AC-3)" truncate rather than
 * colliding with the key label (#16). */
.spec-val {
    width: 380px;
    font-size: 14px;
    font-weight: bold;
    color: #f1f5f9;
    letter-spacing: 0.5px;
    text-align: right;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Footer Hints */
#mediainfo-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 28px;
    margin-top: 30px;
    width: 1304px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.footer-glyph {
    width: 20px;
    height: 20px;
    display: inline-block;
}

.glyph-badge {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 18px;
    height: 18px;
}

.footer-text {
    font-size: 13px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1px;
}

#footer-engine-ver {
    margin-left: auto;
    font-size: 13px;
    font-weight: bold;
    color: #475569;
    letter-spacing: 1px;
}
