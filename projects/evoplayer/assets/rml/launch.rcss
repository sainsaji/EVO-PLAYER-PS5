/* =============================================================================
 * EVO PLAYER PRO - Launch / Home screen
 *
 * Geometry follows ui/include/evo_metrics.h so a host render and a console
 * capture line up under shot.py diff, with one deliberate shift: the legacy
 * screen drew no navigation rail (page.no_rail), and this one sits beside the
 * 96 px navbar.rml overlay like every other RmlUi screen. So the content
 * column starts at EVO_CONTENT_X (152) rather than the 88 px bleed, and is
 * EVO_CONTENT_W (1704) wide like every other screen. Tiles are 264 + 24 gap:
 * 6*264 + 5*24 = 1704 exactly.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#launch-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}

/* =============================== Header =============================== */

#launch-header {
    position: absolute;
    left: 0;
    top: 72px;
    width: 1704px;
    height: 88px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#brand {
    display: flex;
    flex-direction: row;
    align-items: center;
}

/* The accent bloom behind the mark, standing in for evo_ui_circle(). */
#brand-mark {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: #ffcd001a;
    border-width: 1px;
    border-color: #ffcd0038;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
}

#brand-logo {
    width: 40px;
    height: 40px;
    display: inline-block;
}

#brand-text {
    display: flex;
    flex-direction: column;
}

#brand-name {
    font-size: 32px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 3px;
}

#brand-version {
    font-size: 14px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2.5px;
    margin-top: 5px;
}

#status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

#status-clock {
    font-size: 32px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 1.5px;
}

#status-theme-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

#status-theme-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #00cdff;
    margin-right: 8px;
}

#status-theme {
    font-size: 14px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2.5px;
}

/* ================================ Hero ================================ */

#hero {
    position: absolute;
    left: 0;
    top: 200px;
    width: 1704px;
    height: 318px;
    background-color: #0f1829;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 22px;
    overflow: hidden;
}

/*
 * Cover-crop, not stretch: the source is 16:9 and the hero is closer to
 * 5.5:1, so fitting the box makes faces visibly wide. The image decorator
 * with `cover` is the retained-mode equivalent of the fixed-point centre-crop
 * in draw_hero(); an oversized <img> clipped by overflow is not, because
 * overflow does not clip absolutely-positioned children here — it painted
 * the poster across the whole page.
 */
@keyframes heroKen {
    from { transform: scale(1.02); }
    to   { transform: scale(1.10); }
}

#hero-art {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 1702px;
    height: 316px;
    border-radius: 21px;
    animation: 20s cubic-in-out infinite alternate heroKen;
}

/*
 * Artwork fades out towards the left so the copy sits on flat surface colour
 * while the frame still reads as a backdrop. A region that simply starts
 * partway across leaves a hard vertical seam down the middle of the card.
 */
#hero-fade-l {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 520px;
    height: 316px;
    background-color: #0f1829;
}

#hero-fade-h {
    position: absolute;
    left: 521px;
    top: 1px;
    width: 600px;
    height: 316px;
    decorator: horizontal-gradient(#0f1829ff #0f182900);
}

/* Bottom scrim, so the chip and the bar sit on a consistent ground. */
#hero-fade-b {
    position: absolute;
    left: 1px;
    bottom: 1px;
    width: 1702px;
    height: 170px;
    decorator: vertical-gradient(#02040a00 #02040add);
}

#hero-copy {
    position: absolute;
    left: 56px;
    top: 38px;
    width: 900px;
    display: flex;
    flex-direction: column;
}

#hero-eyebrow-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#hero-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #ffcd00;
    margin-right: 10px;
}

#hero-eyebrow {
    font-size: 15px;
    font-weight: bold;
    color: #ffcd00;
    letter-spacing: 2.6px;
}

#hero-title {
    font-size: 44px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-top: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#hero-detail {
    font-size: 19px;
    font-weight: normal;
    color: #a3b6d0;
    letter-spacing: 0.5px;
    margin-top: 14px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#hero-foot {
    position: absolute;
    left: 56px;
    bottom: 28px;
    width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

#hero-progress-track {
    width: 560px;
    height: 5px;
    border-radius: 3px;
    background-color: #7896c833;
    margin-bottom: 18px;
}

/* Explicitly block: an inline element ignores width, so the fill drew
 * nothing and the bar read as an empty track at every position. */
#hero-progress-fill {
    display: block;
    width: 0%;
    height: 5px;
    border-radius: 3px;
    background-color: #ffcd00;
    transition: width 0.35s cubic-out;
}

/*
 * Chip geometry with smooth transitions matching ui.html
 */
#hero-chip {
    height: 58px;
    border-radius: 29px;
    background-color: #162238eb;
    border-width: 1px;
    border-color: #00cdff47;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 20px;
    transition: transform 0.2s cubic-out, background-color 0.2s cubic-out, border-color 0.2s cubic-out;
}

#hero.hero-focused #hero-chip,
.hero-chip-focused {
    transform: scale(1.04);
    background-color: #1e2e4af5;
    border-color: #00cdff;
}

#hero-chip-glyph-box {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: #00cdff1f;
    border-width: 1px;
    border-color: #00cdff73;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

#hero-chip-glyph {
    width: 18px;
    height: 18px;
    display: inline-block;
}

#hero-chip-label {
    font-size: 21px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 2px;
}

/* =============================== Shelves =============================== */

#shelves {
    position: absolute;
    left: 0;
    top: 556px;
    width: 1704px;
    display: flex;
    flex-direction: column;
}

/* 36 px label band + 166 px tiles = 202, and 26 of air below, so the second
 * shelf lands at 784 and its tiles end at 986 — clear of the footer. Hiding
 * the first shelf reflows the second up into its slot, which is what
 * draw_launch() does by hand. */
.shelf {
    width: 1704px;
    margin-bottom: 26px;
}

.shelf-head {
    width: 1704px;
    height: 36px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.shelf-label {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.shelf-tick {
    width: 3px;
    height: 18px;
    border-radius: 2px;
    background-color: #ffcd00;
    margin-right: 14px;
}

.shelf-title {
    font-size: 22px;
    font-weight: bold;
    color: #c2d2e8;
    letter-spacing: 2.2px;
}

.shelf-count {
    font-size: 14px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2px;
}

.shelf-tiles {
    width: 1704px;
    height: 166px;
    display: flex;
    flex-direction: row;
    gap: 24px;
}

/* ================================ Tiles ================================ */

.tile {
    width: 264px;
    height: 166px;
    background-color: #101a2ceb;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 18px;
    position: relative;
    overflow: hidden;
    transition: transform 0.18s cubic-out, border-color 0.18s cubic-out, background-color 0.18s cubic-out;
}

.tile-focused {
    background-color: #16223af5;
    border-width: 2px;
    border-color: #ffcd00;
    transform: scale(1.04);
}

.tile-destination {
    background-color: #0f1828eb;
}

.tile-destination.tile-focused {
    background-color: #16223af5;
    border-width: 2px;
    border-color: #00cdff;
    transform: scale(1.04);
}

.tile-art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 18px;
}

.tile-index {
    position: absolute;
    right: 16px;
    top: 18px;
    z-index: 3;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #a0bee659;
}

/* Destination tiles carry an icon box top-left. */
.tile-icon-box {
    position: absolute;
    left: 18px;
    top: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tile-icon {
    width: 36px;
    height: 36px;
    display: inline-block;
}

.tile-icon-box-lg {
    position: absolute;
    left: 20px;
    top: 20px;
    z-index: 3;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background-color: #00cdff14;
    border-width: 1px;
    border-color: #00cdff33;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s cubic-out, border-color 0.18s cubic-out;
}

.tile.tile-focused .tile-icon-box-lg {
    background-color: #00cdff26;
    border-color: #00cdff;
}

.tile-icon-lg {
    width: 30px;
    height: 30px;
}

.tile-status {
    position: absolute;
    right: 16px;
    bottom: 20px;
    z-index: 3;
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #3ddc84;
    display: none;
}

#lib-status-0,
#lib-status-3 {
    display: block;
}

/* Without this a bright frame makes the caption unreadable. */
.tile-scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 110px;
    z-index: 2;
    decorator: vertical-gradient(#00000000 #000000f0);
}

.tile-caption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    z-index: 3;
    display: flex;
    flex-direction: column;
}

.tile-title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.tile-detail {
    font-size: 15px;
    font-weight: normal;
    color: #c3d2e6;
    letter-spacing: 0.6px;
    margin-top: 5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.tile-progress-track {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 8px;
    height: 5px;
    z-index: 4;
    border-radius: 3px;
    background-color: #7896c838;
}

.tile-progress-fill {
    display: block;
    width: 0%;
    height: 5px;
    border-radius: 3px;
    background-color: #ffcd00;
}

.tile-badge {
    position: absolute;
    right: 14px;
    top: 14px;
    z-index: 3;
    height: 24px;
    padding: 0 10px;
    border-radius: 12px;
    background-color: #060c16c7;
    border-width: 1px;
    border-color: #7896c847;
    display: flex;
    align-items: center;
    font-size: 11px;
    font-weight: bold;
    color: #a3b6d0;
    letter-spacing: 1.4px;
}

/* =============================== Footer =============================== */

#launch-footer {
    position: absolute;
    left: 0;
    bottom: 40px;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.footer-glyph {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.glyph-badge {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 19px;
    background-color: #14223ab8;
    border-width: 1px;
    border-color: #7896c838;
}

.glyph-badge-img {
    width: 24px;
    height: 24px;
}

.footer-text {
    font-size: 14px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1.8px;
}
