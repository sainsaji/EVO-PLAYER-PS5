/* =============================================================================
 * EVO PLAYER PRO - Modern Cinema Settings RCSS Stylesheet
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Left Navigation Rail styles removed — rail is now the standalone navbar.rml overlay */


/* Content pane at EVO_CONTENT_X, leaving the 44 px channel the native
 * layout puts between EVO_RAIL_W and the first card. */
#content-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}


/* Header */
#settings-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 96px;
    margin-bottom: 42px;
    width: 1704px;
}

#header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#header-indicator {
    width: 5px;
    height: 62px;
    background-color: #0070d1;
    border-radius: 2px;
    margin-right: 18px;
}

#header-titles {
    display: flex;
    flex-direction: column;
}

#settings-title {
    font-size: 43px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
}

#settings-subtitle {
    font-size: 15px;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1px;
    margin-top: 3px;
}

#settings-counter {
    font-size: 15px;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

/* Settings List */
#settings-list {
    display: flex;
    flex-direction: column;
    width: 1704px;
}

.setting-row {
    width: 1704px;
    height: 92px;
    background-color: #0c1322;

    border-width: 1px;
    border-color: #172338;
    border-radius: 20px;
    margin-bottom: 12px;
    padding: 0 32px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.row-focused {
    background-color: #142036;
    border-width: 1.5px;
    border-color: #38bdf8;
}

.row-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.row-icon-box {
    width: 60px;
    height: 60px;
    background-color: #131c2e;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.row-focused .row-icon-box {
    background-color: #1a2a47;
}

.row-icon {
    width: 30px;
    height: 30px;
    display: inline-block;
}

/* Bounded so a long row title/detail ellipsises rather than colliding with the
 * value badge on the right (#16). 1640 inner - 80 icon - ~600 value column. */
.row-text-box {
    display: flex;
    flex-direction: column;
    max-width: 940px;
}

.row-title {
    font-size: 33px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-detail {
    font-size: 18px;
    font-weight: normal;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin-top: 4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    max-width: 600px;
}

.row-badge {
    background-color: #131d2e;
    border-width: 1px;
    border-color: #243550;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 15px;
    font-weight: bold;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin-right: 18px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-focused .row-badge {
    background-color: #0369a1;
    border-color: #38bdf8;
    color: #ffffff;
}

.row-chevron {
    width: 20px;
    height: 20px;
    display: inline-block;
}

.row-hidden {
    display: none;
}

.badge-hidden {
    display: none;
}

/* Footer Hints */
#settings-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}


.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.footer-glyph {
    width: 30px;
    height: 30px;
    display: inline-block;
}

.glyph-badge {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 21px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 28px;
    height: 28px;
}

.footer-text {
    font-size: 15px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1px;
}

#footer-version {
    margin-left: auto;
    font-size: 15px;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1px;
}
