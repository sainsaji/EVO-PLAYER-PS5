/* =============================================================================
 * EVO PLAYER PRO - Modern Cinema Settings RCSS Stylesheet
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Left Navigation Rail styles removed — rail is now the standalone navbar.rml overlay */


/* Content pane at EVO_CONTENT_X, leaving the 44 px channel the native
 * layout puts between EVO_RAIL_W and the first card. */
#content-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}


/* Header */
#settings-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 72px;
    margin-bottom: 36px;
    width: 1704px;
    height: 88px;
    border-bottom-width: 1px;
    border-bottom-color: #5a7db433;
    padding-bottom: 18px;
}

#header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#settings-badge {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background-color: #00cdff1a;
    border-width: 1px;
    border-color: #00cdff4d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 22px;
}

#settings-badge-icon {
    width: 34px;
    height: 34px;
}

#header-titles {
    display: flex;
    flex-direction: column;
}

#settings-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

#settings-title {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 3px;
}

#settings-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #3ddc84;
}

#settings-subtitle {
    font-size: 14px;
    font-weight: bold;
    color: #a3b6d0;
    letter-spacing: 2px;
    margin-top: 5px;
}

#settings-counter {
    font-size: 14px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2px;
    background-color: #1420368c;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 10px;
    padding: 8px 18px;
}

/* Settings List */
#settings-list {
    display: flex;
    flex-direction: column;
    width: 1704px;
}

.setting-row {
    width: 1704px;
    height: 84px;
    background-color: #101a2ceb;
    border-width: 1px;
    border-color: #5a7db429;
    border-radius: 16px;
    margin-bottom: 12px;
    padding: 0 24px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.18s cubic-out, border-color 0.18s cubic-out, background-color 0.18s cubic-out;
}

.row-focused {
    background-color: #16223af5;
    border-width: 1.5px;
    border-color: #ffcd00;
    transform: scale(1.012);
}

.row-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.row-icon-box {
    width: 52px;
    height: 52px;
    background-color: #00cdff14;
    border-width: 1px;
    border-color: #00cdff33;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    transition: background-color 0.18s cubic-out, border-color 0.18s cubic-out;
}

.row-focused .row-icon-box {
    background-color: #ffcd001f;
    border-color: #ffcd0073;
}

.row-icon {
    width: 26px;
    height: 26px;
    display: inline-block;
}

/* Bounded so a long row title/detail ellipsises rather than colliding with the
 * value badge on the right (#16). 1640 inner - 80 icon - ~600 value column. */
.row-text-box {
    display: flex;
    flex-direction: column;
    max-width: 940px;
}

.row-title {
    font-size: 22px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-detail {
    font-size: 13.5px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 0.6px;
    margin-top: 4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-focused .row-detail {
    color: #ffcd00;
}

.row-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    max-width: 600px;
}

.row-badge {
    background-color: #0a101c99;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 10px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: bold;
    color: #7c8ba3;
    letter-spacing: 1.4px;
    margin-right: 16px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.row-focused .row-badge {
    background-color: #ffcd0029;
    border-color: #ffcd00;
    color: #ffcd00;
}

.row-chevron {
    width: 20px;
    height: 20px;
    display: inline-block;
}

.row-hidden {
    display: none;
}

.badge-hidden {
    display: none;
}

/* Footer Hints */
#settings-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.footer-glyph {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.glyph-badge {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 19px;
    background-color: #14223ab8;
    border-width: 1px;
    border-color: #7896c838;
}

.glyph-badge-img {
    width: 24px;
    height: 24px;
}

.footer-text {
    font-size: 14px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1.8px;
}

#footer-version {
    margin-left: auto;
    font-size: 14px;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1px;
}
