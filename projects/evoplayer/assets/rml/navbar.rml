<rml>
<head>
    <link type="text/rcss" href="navbar.rcss"/>
</head>
<body id="navbar-body">
    <!-- ================================================================
         Collapsed rail (always visible when nav is shown)
         ================================================================ -->
    <div id="nav-rail-bg"></div>

    <!-- EVO logo mark -->
    <div id="nav-logo">
        <img id="nav-logo-img" src="../icons/icon_logo.png"/>
    </div>

    <!-- Icon-only collapsed items (5 top-level sections) -->
    <div id="nav-items">
        <!-- 0: HOME -->
        <div class="rail-item-wrap" id="nav-wrap-0">
            <div class="rail-accent-bar" id="nav-bar-0"></div>
            <div class="rail-item" id="nav-item-0">
                <img src="../icons/icon_home.png" class="rail-icon" id="nav-icon-0"/>
            </div>
        </div>
        <!-- 1: BROWSE -->
        <div class="rail-item-wrap" id="nav-wrap-1">
            <div class="rail-accent-bar" id="nav-bar-1"></div>
            <div class="rail-item" id="nav-item-1">
                <img src="../icons/icon_browse_usb.png" class="rail-icon" id="nav-icon-1"/>
            </div>
        </div>
        <!-- 2: EMBY -->
        <div class="rail-item-wrap" id="nav-wrap-2">
            <div class="rail-accent-bar" id="nav-bar-2"></div>
            <div class="rail-item" id="nav-item-2">
                <img src="../icons/icon_emby.png" class="rail-icon" id="nav-icon-2"/>
            </div>
        </div>
        <!-- 3: SETTINGS -->
        <div class="rail-item-wrap" id="nav-wrap-3">
            <div class="rail-accent-bar" id="nav-bar-3"></div>
            <div class="rail-item" id="nav-item-3">
                <img src="../icons/icon_settings.png" class="rail-icon" id="nav-icon-3"/>
            </div>
        </div>
        <!-- 4: ABOUT -->
        <div class="rail-item-wrap" id="nav-wrap-4">
            <div class="rail-accent-bar" id="nav-bar-4"></div>
            <div class="rail-item" id="nav-item-4">
                <img src="../icons/icon_about_support.png" class="rail-icon" id="nav-icon-4"/>
            </div>
        </div>
    </div>

    <!-- ================================================================
         Expanded overlay (shown when rail_focused = true)
         ================================================================ -->
    <div id="nav-scrim"></div>
    <div id="nav-expanded">
        <!-- Logo + app name -->
        <div id="nav-expanded-logo">
            <img id="nav-expanded-logo-img" src="../icons/icon_logo.png"/>
        </div>
        <div id="nav-app-label">EVO</div>

        <!-- Labelled items -->
        <div id="nav-expanded-items">
            <div class="rail-exp-item" id="nav-exp-0">
                <img id="nav-exp-icon-0" src="../icons/icon_home.png" class="rail-exp-icon"/>
                <span class="rail-exp-label" id="nav-exp-label-0">HOME</span>
            </div>
            <div class="rail-exp-item" id="nav-exp-1">
                <img id="nav-exp-icon-1" src="../icons/icon_browse_usb.png" class="rail-exp-icon"/>
                <span class="rail-exp-label" id="nav-exp-label-1">BROWSE</span>
            </div>
            <div class="rail-exp-item" id="nav-exp-2">
                <img id="nav-exp-icon-2" src="../icons/icon_emby.png" class="rail-exp-icon"/>
                <span class="rail-exp-label" id="nav-exp-label-2">EMBY</span>
            </div>
            <div class="rail-exp-item" id="nav-exp-3">
                <img id="nav-exp-icon-3" src="../icons/icon_settings.png" class="rail-exp-icon"/>
                <span class="rail-exp-label" id="nav-exp-label-3">SETTINGS</span>
            </div>
            <div class="rail-exp-item" id="nav-exp-4">
                <img id="nav-exp-icon-4" src="../icons/icon_about_support.png" class="rail-exp-icon"/>
                <span class="rail-exp-label" id="nav-exp-label-4">ABOUT</span>
            </div>
        </div>
    </div>
</body>
</rml>
