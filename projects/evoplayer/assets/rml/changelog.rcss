/* =============================================================================
 * EVO PLAYER PRO - Changelog
 *
 * Master-detail, like the immediate-mode original: the releases down the
 * left, what changed in the selected one down the right. A single flat list
 * of every item across every release is unreadable at ten feet, which is why
 * this screen is not just another list.rml.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#changelog-pane {
    position: absolute;
    left: 152dp;
    top: 0;
    width: 1768dp;
    height: 1080dp;
}

/* =============================== Header =============================== */

#changelog-header {
    position: absolute;
    left: 0;
    top: 96dp;
    width: 1704dp;
    height: 52dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

#changelog-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#changelog-indicator {
    width: 5dp;
    height: 62dp;
    background-color: #00cdff;
    border-radius: 2dp;
    margin-right: 18dp;
}

#changelog-header-titles {
    display: flex;
    flex-direction: column;
}

#changelog-title {
    display: block;
    font-size: 43dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5dp;
}

#changelog-subtitle {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1dp;
    margin-top: 3dp;
}

#changelog-counter {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1dp;
    margin-bottom: 6dp;
}

/* ============================ Master column ============================ */

/* 600 for the releases, 24 gutter, 1080 for the detail = 1704. */
#changelog-releases {
    position: absolute;
    left: 0;
    top: 222dp;
    width: 600dp;
    display: flex;
    flex-direction: column;
}

.clrel {
    width: 600dp;
    height: 96dp;
    background-color: #121b2eeb;
    border-width: 1dp;
    border-color: #2a3b55aa;
    border-radius: 18dp;
    margin-bottom: 10dp;
    padding-left: 22dp;
    padding-right: 22dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.clrel-focused {
    background-color: #1b2e4cf5;
    border-width: 1.5dp;
    border-color: #00cdff;
}

.clrel-text {
    display: flex;
    flex-direction: column;
    width: 430dp;
}

.clrel-ver {
    display: block;
    font-size: 30dp;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 0.5dp;
}

.clrel-tag {
    display: block;
    font-size: 17dp;
    font-weight: normal;
    color: #9fb2cc;
    letter-spacing: 0.5dp;
    margin-top: 4dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.clrel-date {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1dp;
}

/* ============================ Detail column ============================ */

#changelog-detail {
    position: absolute;
    left: 624dp;
    top: 222dp;
    width: 1080dp;
    height: 714dp;
    background-color: #121b2eeb;
    border-width: 1dp;
    border-color: #2a3b55aa;
    border-radius: 20dp;
    padding: 26dp;
}

#cldetail-head {
    display: flex;
    flex-direction: column;
    width: 1028dp;
    margin-bottom: 20dp;
    padding-bottom: 16dp;
    border-bottom-width: 1dp;
    border-bottom-color: #1b2740;
}

#cldetail-ver {
    display: block;
    font-size: 36dp;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 0.5dp;
}

#cldetail-tag {
    display: block;
    width: 1028dp;
    font-size: 17dp;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 1.5dp;
    margin-top: 6dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#cldetail-items {
    display: flex;
    flex-direction: column;
    width: 1028dp;
}

.clitem {
    width: 1028dp;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 14dp;
}

/*
 * The kind is a chip rather than a colour on the text: NEW, FIXED and
 * IMPROVED have to be told apart at ten feet, and hue alone does not carry
 * that far — nor does it survive a theme that recolours the accent.
 */
.clitem-kind {
    width: 128dp;
    height: 32dp;
    border-radius: 11dp;
    border-width: 1dp;
    border-color: #243550;
    background-color: #131d2e;
    font-size: 15dp;
    font-weight: bold;
    color: #9fb2cc;
    letter-spacing: 1dp;
    text-align: center;
    padding-top: 6dp;
    margin-right: 20dp;
}

.clitem-text {
    display: block;
    width: 860dp;
    font-size: 18dp;
    font-weight: normal;
    color: #cfdcef;
    letter-spacing: 0.3dp;
    padding-top: 3dp;
}

/* Releases can carry more entries than the panel holds; say so rather than
 * silently truncating. */
#cldetail-more {
    display: none;
    font-size: 15dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1dp;
    margin-top: 6dp;
}

/* =============================== Footer =============================== */

#changelog-footer {
    position: absolute;
    bottom: 40dp;
    left: 0;
    width: 1704dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32dp;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.footer-glyph {
    width: 30dp;
    height: 30dp;
    display: inline-block;
}

.glyph-badge {
    width: 42dp;
    height: 42dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 21dp;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 28dp;
    height: 28dp;
}

.footer-text {
    font-size: 15dp;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1dp;
}

#changelog-footer-version {
    margin-left: auto;
    font-size: 15dp;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1dp;
}
