/* =============================================================================
 * EVO PLAYER PRO - Playback HUD & OSD Stylesheet (RCSS)
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Top Gradient Scrim */
#top-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 150px;
    padding: 36px 60px 0 60px;
    background-color: #06080de8;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    overflow: hidden;
}

/*
 * Fixed-width clip window for the title + metadata (#16): 1920 - 120 padding
 * - ~360 badge rack. A long title/metadata line is clipped here instead of
 * pushing the badge rack off the right edge, and the C++ marquee tick slides
 * #media-title left inside this window to reveal the tail (#44), matching the
 * legacy evo_text_marquee ping-pong.
 */
#title-block {
    display: block;
    width: 1180px;
    height: 78px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
}

#media-title {
    font-size: 34px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

#media-meta {
    font-size: 15px;
    color: #a2b0c2;
    font-weight: bold;
    letter-spacing: 0.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 1180px;
    margin-top: 6px;
}

#badge-rack {
    display: flex;
    flex-direction: row;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
    flex-shrink: 0;
}

.badge-res {
    display: none;
    background-color: #00d2ff;
    color: #080a0f;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
    letter-spacing: 0.5px;
}

.badge-hdr {
    display: none;
    background-color: #ffd700;
    color: #080a0f;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
    letter-spacing: 0.5px;
}

.badge-codec {
    display: none;
    background-color: #141c28;
    border-width: 1px;
    border-color: #2a374a;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
}

.badge-fps {
    display: none;
    background-color: #1e293b;
    border-width: 1px;
    border-color: #334155;
    color: #38bdf8;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
}

/* Center Scrubbing & Pause Overlay */
#center-overlay {
    position: absolute;
    top: 440px;
    left: 710px;
    width: 500px;
    height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

#scrub-capsule {
    display: none;
    background-color: #0c1018f2;
    border-width: 2px;
    border-color: #00d2ff;
    border-radius: 28px;
    padding: 10px 28px;
    flex-direction: row;
    align-items: center;
    gap: 14px;
}

#scrub-label {
    font-size: 15px;
    font-weight: bold;
    color: #00d2ff;
    letter-spacing: 1.5px;
}

#scrub-time {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
}

#pause-badge {
    display: none;
    background-color: #0070d1e6;
    border-width: 1px;
    border-color: #38bdf8;
    border-radius: 12px;
    padding: 10px 26px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

#pause-label {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2px;
}

/* Stats for Nerds HUD */
#stats-hud {
    display: none;
    position: absolute;
    top: 150px;
    left: 60px;
    width: 480px;
    background-color: #080c14f0;
    border-width: 1px;
    border-color: #1e2838;
    border-radius: 14px;
    padding: 16px 20px;
    flex-direction: column;
    gap: 8px;
}

.stats-title {
    font-size: 13px;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #1a2332;
    padding-bottom: 6px;
}

.stats-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stats-k {
    font-size: 13px;
    color: #8c9bb0;
    font-weight: bold;
}

.stats-v {
    font-size: 14px;
    font-weight: bold;
    color: #f8fafc;
}

.text-green { color: #00ffaa; }
.text-cyan  { color: #00d2ff; }

/* Bottom Controller Console */
#bottom-scrim {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1920px;
    height: 190px;
    padding: 24px 60px 28px 60px;
    background-color: #06080df5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

/* Sapphire Timeline Progress Bar */
#progress-container {
    width: 1800px;
    height: 24px;
    display: flex;
    align-items: center;
    margin-bottom: 6px;
}

#progress-track {
    width: 1800px;
    height: 8px;
    background-color: #1d293d;
    border-radius: 4px;
    position: relative;
}

#progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 8px;
    background-color: #0070d1;
    border-radius: 4px;
}

#progress-thumb {
    position: absolute;
    right: -8px;
    top: -5px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #ffffff;
    border-width: 3px;
    border-color: #0070d1;
}

/* Time Row */
#time-row {
    width: 1800px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

#time-current {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
}

#time-duration {
    font-size: 16px;
    font-weight: bold;
    color: #a2b0c2;
}

/* Bottom Action Ribbon & Hints */
#controls-row {
    width: 1800px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 28px;
}

.control-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.btn-icon {
    width: 22px;
    height: 22px;
    display: inline-block;
}

.glyph-badge {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 20px;
    height: 20px;
}

.btn-tag {
    background-color: #1a2336;
    border-width: 1px;
    border-color: #2e3e5c;
    padding: 2px 7px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: bold;
    color: #00d2ff;
}

.control-label {
    font-size: 14px;
    color: #e2e8f0;
    font-weight: bold;
    letter-spacing: 0.5px;
}
