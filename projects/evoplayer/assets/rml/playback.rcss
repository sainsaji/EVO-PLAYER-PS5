/* =============================================================================
 * EVO PLAYER PRO - Playback HUD & OSD Stylesheet (RCSS)
 * Premium PlayStation Obsidian & Sapphire Blue Theme
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Top Gradient Scrim */
#top-scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 150px;
    padding: 36px 60px 0 60px;
    background-color: #06080de8;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    overflow: hidden;
}

/*
 * Fixed-width clip window for the title + metadata (#16): 1920 - 120 padding
 * - ~360 badge rack. A long title/metadata line is clipped here instead of
 * pushing the badge rack off the right edge, and the C++ marquee tick slides
 * #media-title left inside this window to reveal the tail (#44), matching the
 * legacy evo_text_marquee ping-pong.
 */
#title-block {
    display: block;
    width: 1180px;
    height: 78px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
}

#media-title {
    font-size: 34px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

#media-meta {
    font-size: 15px;
    color: #a2b0c2;
    font-weight: bold;
    letter-spacing: 0.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 1180px;
    margin-top: 6px;
}

#badge-rack {
    display: flex;
    flex-direction: row;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
    flex-shrink: 0;
}

.badge-res {
    display: none;
    background-color: #00d2ff;
    color: #080a0f;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
    letter-spacing: 0.5px;
}

.badge-hdr {
    display: none;
    background-color: #ffd700;
    color: #080a0f;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
    letter-spacing: 0.5px;
}

.badge-codec {
    display: none;
    background-color: #141c28;
    border-width: 1px;
    border-color: #2a374a;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
}

.badge-fps {
    display: none;
    background-color: #1e293b;
    border-width: 1px;
    border-color: #334155;
    color: #38bdf8;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
}

/* #59: decoder backend badge (colour set inline by decoder type) */
.badge-decoder {
    display: none;
    background-color: #141c28;
    border-width: 1px;
    border-color: #2a374a;
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 9px;
}

/* On-video caption overlay (#81)
 *
 * Full-width layer, text centred; the box shrink-wraps the caption and carries a
 * translucent plate so white text stays legible over any frame. `raised` lifts
 * it clear of the bottom controller bar while the OSD is up. Size classes map to
 * prospero_subtitle_face (SUB / MENU / TITLE = small / medium / large). */
#subtitle-layer {
    position: absolute;
    left: 0;
    width: 1920px;
    bottom: 96px;
    text-align: center;
    z-index: 5;
}

#subtitle-layer.raised {
    bottom: 300px;
}

#subtitle-box {
    display: none;
    max-width: 1560px;
    background-color: #000000a0;
    border-radius: 8px;
    padding: 4px 20px;
    color: #fbfcff;
    font-weight: bold;
    font-size: 40px;
    line-height: 1.28;
    text-align: center;
    letter-spacing: 0.3px;
}

#subtitle-box.sub-small  { font-size: 31px; }
#subtitle-box.sub-medium { font-size: 40px; }
#subtitle-box.sub-large  { font-size: 52px; }

/* Music "NOW PLAYING" visualiser (#81) */
#music-view {
    display: none;
    position: absolute;
    left: 460px;
    top: 220px;
    width: 1000px;
    height: 360px;
    flex-direction: column;
}

#music-card {
    width: 1000px;
    height: 220px;
    background-color: #0c1524e6;
    border-width: 1px;
    border-color: #00b6f5a0;
    border-radius: 28px;
    padding: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

#music-art {
    width: 96px;
    height: 96px;
    background-color: #00d2ffcc;
    border-radius: 14px;
    margin-right: 40px;
    flex-shrink: 0;
}

#music-lines { display: flex; flex-direction: column; }

#music-title {
    font-size: 30px;
    font-weight: bold;
    color: #eaf6ff;
    letter-spacing: 0.5px;
}

#music-state {
    font-size: 22px;
    font-weight: bold;
    color: #00d2ff;
    margin-top: 12px;
}

#music-hint {
    font-size: 15px;
    font-weight: bold;
    color: #86b7d0;
    margin-top: 16px;
}

#music-bars {
    margin-top: 40px;
    width: 1000px;
    height: 100px;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 14px;
}

@keyframes mbar-pulse {
    0%   { height: 22px; }
    50%  { height: 96px; }
    100% { height: 22px; }
}

.mbar {
    width: 22px;
    height: 40px;
    background-color: #12b6ea;
    border-radius: 3px;
    animation: 1.1s cubic-in-out -0.05s infinite alternate mbar-pulse;
}

/* Stagger the wave and vary the resting heights so it reads as an equaliser
 * even if the driver skips the animation. */
.mbar:nth-child(2n) { height: 74px; background-color: #23c6f0;
    animation: 1.1s cubic-in-out -0.30s infinite alternate mbar-pulse; }
.mbar:nth-child(3n) { height: 30px; background-color: #3ad0f5;
    animation: 1.1s cubic-in-out -0.55s infinite alternate mbar-pulse; }
.mbar:nth-child(4n) { height: 92px;
    animation: 1.1s cubic-in-out -0.80s infinite alternate mbar-pulse; }
.mbar:nth-child(5n) { height: 52px; background-color: #1aa8dd;
    animation: 1.1s cubic-in-out -0.15s infinite alternate mbar-pulse; }

#music-view.paused .mbar { animation: none; height: 24px; }

/* Center Scrubbing & Pause Overlay */
#center-overlay {
    position: absolute;
    top: 440px;
    left: 710px;
    width: 500px;
    height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

#scrub-capsule {
    display: none;
    background-color: #0c1018f2;
    border-width: 2px;
    border-color: #00d2ff;
    border-radius: 28px;
    padding: 10px 28px;
    flex-direction: row;
    align-items: center;
    gap: 14px;
}

#scrub-label {
    font-size: 15px;
    font-weight: bold;
    color: #00d2ff;
    letter-spacing: 1.5px;
}

#scrub-time {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
}

#pause-badge {
    display: none;
    background-color: #0070d1e6;
    border-width: 1px;
    border-color: #38bdf8;
    border-radius: 12px;
    padding: 10px 26px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

#pause-label {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2px;
}

/* Dev FPS pill (#81) — top-right, independent of the OSD chrome */
#fps-pill {
    display: none;
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: #000000aa;
    border-radius: 6px;
    padding: 4px 10px;
    z-index: 8;
}

#fps-value {
    font-size: 15px;
    font-weight: bold;
    color: #f8fafc;
    letter-spacing: 0.5px;
}

/* Playback diagnostic HUD (#81 / #63) */
#stats-hud {
    display: none;
    position: absolute;
    top: 150px;
    left: 60px;
    width: 560px;
    background-color: #080c14f2;
    border-width: 1px;
    border-color: #1e2838;
    border-radius: 14px;
    padding: 16px 20px;
    flex-direction: column;
    gap: 6px;
}

.stats-title {
    font-size: 13px;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #1a2332;
    padding-bottom: 6px;
}

.stats-line {
    font-size: 13px;
    font-weight: bold;
    color: #d4dde8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.stats-sep {
    height: 1px;
    background-color: #1a2332;
    margin-top: 4px;
    margin-bottom: 2px;
}

.graph-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 10px;
    height: 40px;
}

.graph-label {
    font-size: 12px;
    font-weight: bold;
    width: 38px;
    flex-shrink: 0;
}

.graph {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 36px;
    width: 400px;
    background-color: #0c121c;
    border-radius: 4px;
    padding: 2px;
    flex-shrink: 0;
}

.graph-bar {
    width: 6px;
    margin-right: 1px;
    min-height: 1px;
    background-color: #38506e;
}

.graph-val {
    font-size: 12px;
    font-weight: bold;
    width: 58px;
    flex-shrink: 0;
    text-align: right;
}

.text-green { color: #00ffaa; }
.text-cyan  { color: #00d2ff; }
.text-amber { color: #ffb020; }

/* Bottom Controller Console */
#bottom-scrim {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1920px;
    height: 190px;
    padding: 24px 60px 28px 60px;
    background-color: #06080df5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

/* Sapphire Timeline Progress Bar */
#progress-container {
    width: 1800px;
    height: 24px;
    display: flex;
    align-items: center;
    margin-bottom: 6px;
}

#progress-track {
    width: 1800px;
    height: 8px;
    background-color: #1d293d;
    border-radius: 4px;
    position: relative;
}

#progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 8px;
    background-color: #0070d1;
    border-radius: 4px;
}

#progress-thumb {
    position: absolute;
    right: -8px;
    top: -5px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #ffffff;
    border-width: 3px;
    border-color: #0070d1;
}

/* Time Row */
#time-row {
    width: 1800px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

#time-current {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
}

#time-duration {
    font-size: 16px;
    font-weight: bold;
    color: #a2b0c2;
}

/* Bottom Action Ribbon & Hints */
#controls-row {
    width: 1800px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 28px;
}

.control-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.btn-icon {
    width: 22px;
    height: 22px;
    display: inline-block;
}

.glyph-badge {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 20px;
    height: 20px;
}

.btn-tag {
    background-color: #1a2336;
    border-width: 1px;
    border-color: #2e3e5c;
    padding: 2px 7px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: bold;
    color: #00d2ff;
}

.control-label {
    font-size: 14px;
    color: #e2e8f0;
    font-weight: bold;
    letter-spacing: 0.5px;
}
