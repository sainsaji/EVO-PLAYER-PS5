<rml>
<head>
    <link type="text/rcss" href="playback.rcss"/>
</head>
<body id="playback-hud">
    <!-- Top Header Bar -->
    <div id="top-scrim">
        <div id="title-block">
            <div id="media-title"></div>
            <div id="media-meta"></div>
        </div>
        <div id="badge-rack">
            <span id="badge-res" class="badge-res"></span>
            <span id="badge-hdr" class="badge-hdr"></span>
            <span id="badge-codec" class="badge-codec"></span>
            <span id="badge-fps" class="badge-fps"></span>
        </div>
    </div>

    <!-- Center Play/Pause & Scrubbing Overlay -->
    <div id="center-overlay">
        <div id="scrub-capsule">
            <span id="scrub-label">SEEK TO</span>
            <span id="scrub-time">00:00:00</span>
        </div>
        <div id="pause-badge">
            <span id="pause-label">PAUSED</span>
        </div>
    </div>

    <!-- Stats for Nerds HUD (Diagnostic Overlay) -->
    <div id="stats-hud">
        <div class="stats-title">STREAM &amp; HARDWARE DIAGNOSTICS</div>
        <div class="stats-row"><span class="stats-k">VIDEO ENGINE</span><span id="stats-v-engine" class="stats-v">Stage 4 Hardware ASIC</span></div>
        <div class="stats-row"><span class="stats-k">DECODER CORE</span><span id="stats-v-decoder" class="stats-v">libSceAvPlayer HW</span></div>
        <div class="stats-row"><span class="stats-k">AUDIO BITSTREAM</span><span id="stats-v-audio" class="stats-v">SceAudioOut Direct PCM</span></div>
        <div class="stats-row"><span class="stats-k">DROPPED FRAMES</span><span id="stats-v-drops" class="stats-v text-green">0 (0.00%)</span></div>
        <div class="stats-row"><span class="stats-k">DISPLAY CADENCE</span><span id="stats-v-fps" class="stats-v text-cyan">60.0 FPS Stable</span></div>
    </div>

    <!-- Bottom Netflix Controller Bar -->
    <div id="bottom-scrim">
        <!-- Progress Bar Timeline -->
        <div id="progress-container">
            <div id="progress-track">
                <div id="progress-fill">
                    <div id="progress-thumb"></div>
                </div>
            </div>
        </div>

        <!-- Time Row -->
        <div id="time-row">
            <span id="time-current">00:00:00</span>
            <span id="time-duration">00:00:00</span>
        </div>

        <!-- Netflix Action Ribbon & Hints -->
        <div id="controls-row">
            <div class="control-item">
                <div class="glyph-badge"><img src="icons/btn_cross.png" class="glyph-badge-img"/></div>
                <span id="label-playpause" class="control-label">PAUSE</span>
            </div>
            <div class="control-item">
                <div class="glyph-badge"><img src="icons/btn_dpad.png" class="glyph-badge-img"/></div>
                <span class="control-label">SEEK 10s</span>
            </div>
            <div class="control-item">
                <span class="btn-tag">L1 / R1</span>
                <span class="control-label">CHAPTER</span>
            </div>
            <div class="control-item">
                <span class="btn-tag">R2</span>
                <span id="label-audio" class="control-label">AUDIO: Stereo</span>
            </div>
            <div class="control-item">
                <span class="btn-tag">UP / DN</span>
                <span id="label-subs" class="control-label">SUBS: None</span>
            </div>
            <div class="control-item">
                <div class="glyph-badge"><img src="icons/btn_square.png" class="glyph-badge-img"/></div>
                <span class="control-label">INFO</span>
            </div>
            <div class="control-item">
                <div class="glyph-badge"><img src="icons/btn_triangle.png" class="glyph-badge-img"/></div>
                <span id="label-aspect" class="control-label">ASPECT: FIT</span>
            </div>
            <div class="control-item">
                <div class="glyph-badge"><img src="icons/btn_circle.png" class="glyph-badge-img"/></div>
                <span class="control-label">BACK</span>
            </div>
        </div>
    </div>
</body>
</rml>
