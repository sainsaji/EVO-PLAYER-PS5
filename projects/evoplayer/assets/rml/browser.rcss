/* =============================================================================
 * EVO PLAYER PRO - USB Storage Browser
 *
 * Three columns, as in the immediate-mode original: the navigation rail
 * (navbar.rml), the file list, and an inspector showing what the selected
 * file actually is. The list is virtualised — the DOM holds twelve rows and
 * the C side swaps their text as the window moves, so a folder of five
 * thousand files costs exactly what one of five costs.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#browser-pane {
    position: absolute;
    left: 152dp;
    top: 0;
    width: 1768dp;
    height: 1080dp;
}

/* =============================== Header =============================== */

/* =============================== Header =============================== */

#browser-header {
    position: absolute;
    left: 0;
    top: 72dp;
    width: 1704dp;
    height: 88dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1dp;
    border-bottom-color: #5a7db433;
    padding-bottom: 18dp;
}

#browser-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#browser-badge {
    width: 68dp;
    height: 68dp;
    border-radius: 18dp;
    background-color: #00cdff1a;
    border-width: 1dp;
    border-color: #00cdff4d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 22dp;
}

#browser-badge-icon {
    width: 34dp;
    height: 34dp;
}

#browser-header-titles {
    display: flex;
    flex-direction: column;
}

#browser-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12dp;
}

#browser-title {
    display: block;
    font-size: 28dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 3dp;
}

#browser-live-dot {
    width: 7dp;
    height: 7dp;
    border-radius: 4dp;
    background-color: #3ddc84;
}

#browser-path {
    display: block;
    font-size: 14dp;
    font-weight: bold;
    color: #a3b6d0;
    letter-spacing: 2dp;
    margin-top: 5dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 900dp;
}

#browser-counter {
    display: block;
    font-size: 14dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2dp;
    background-color: #1420368c;
    border-width: 1dp;
    border-color: #5a7db433;
    border-radius: 10dp;
    padding: 8dp 18dp;
}

/* ============================== File list ============================== */

#browser-list {
    position: absolute;
    left: 0;
    top: 200dp;
    width: 1116dp;
    height: 750dp;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.brow {
    position: relative;
    width: 1116dp;
    height: 80dp;
    flex-shrink: 0;
    background-color: #101a2ceb;
    border-width: 1dp;
    border-color: #5a7db433;
    border-radius: 16dp;
    margin-bottom: 10dp;
    padding-left: 20dp;
    padding-right: 20dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.18s cubic-out, border-color 0.18s cubic-out, background-color 0.18s cubic-out;
}

.brow-focused {
    background-color: #16223af5;
    border-width: 1.5dp;
    border-color: #ffcd00;
    transform: scale(1.015);
}

.brow-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.brow-icon-box {
    width: 52dp;
    height: 52dp;
    background-color: #00cdff14;
    border-width: 1dp;
    border-color: #00cdff33;
    border-radius: 14dp;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16dp;
    transition: background-color 0.18s cubic-out, border-color 0.18s cubic-out;
}

.brow-focused .brow-icon-box {
    background-color: #ffcd001f;
    border-color: #ffcd0073;
}

.brow-icon {
    width: 26dp;
    height: 26dp;
    display: inline-block;
}

.brow-text {
    display: flex;
    flex-direction: column;
    width: 806dp;
}

.brow-name {
    display: block;
    font-size: 22dp;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.3dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.brow-detail {
    display: block;
    font-size: 13.5dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1.2dp;
    margin-top: 3dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.brow-focused .brow-detail {
    color: #ffcd00;
}

.brow-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12dp;
}

.brow-fav {
    width: 24dp;
    height: 24dp;
    display: none;
}

.brow-badge {
    background-color: #060c16d2;
    border-width: 1dp;
    border-color: #7896c856;
    border-radius: 10dp;
    padding: 5dp 12dp;
    font-size: 11.5dp;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1.4dp;
}

.brow-focused .brow-badge {
    background-color: #ffcd0029;
    border-color: #ffcd00;
    color: #ffcd00;
}

.brow-track {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1116dp;
    height: 4dp;
    border-radius: 2dp;
    background-color: #7896c838;
}

.brow-fill {
    display: block;
    width: 0%;
    height: 4dp;
    border-radius: 2dp;
    background-color: #ffcd00;
}

/* ============================= Empty state ============================= */

#browser-empty {
    display: none;
    position: absolute;
    left: 0;
    top: 320dp;
    width: 1116dp;
    flex-direction: column;
    align-items: center;
}

#browser-empty-icon-box {
    width: 128dp;
    height: 128dp;
    border-radius: 64dp;
    background-color: #121b2eeb;
    border-width: 1dp;
    border-color: #2a3b55aa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26dp;
}

#browser-empty-icon {
    width: 56dp;
    height: 56dp;
    display: inline-block;
}

#browser-empty-title {
    display: block;
    font-size: 33dp;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 1dp;
}

#browser-empty-hint {
    display: block;
    font-size: 18dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1dp;
    margin-top: 12dp;
}

/* ============================== Inspector ============================== */

#inspector {
    position: absolute;
    left: 1140dp;
    top: 200dp;
    width: 564dp;
    height: 750dp;
    background-color: #141f348c;
    border-width: 1dp;
    border-color: #5a7db433;
    border-radius: 18dp;
    padding: 20dp;
    transition: transform 0.2s cubic-out, opacity 0.2s cubic-out;
}

/* 16:9 at the panel's inner width, so a frame from the file is shown at the
 * shape it was shot in rather than letterboxed into a square. */
#ins-preview {
    position: relative;
    width: 524dp;
    height: 295dp;
    background-color: #0a101cd9;
    border-radius: 14dp;
    border-width: 1dp;
    border-color: #00cdff29;
    overflow: hidden;
}

#ins-preview-art {
    position: absolute;
    left: 1dp;
    top: 1dp;
    width: 522dp;
    height: 293dp;
    border-radius: 12dp;
}

#ins-preview-play {
    position: absolute;
    left: 236dp;
    top: 121dp;
    width: 52dp;
    height: 52dp;
    border-radius: 26dp;
    background-color: #060c16b8;
    border-width: 1dp;
    border-color: #ffffff38;
    display: none;
    align-items: center;
    justify-content: center;
}

#ins-preview-play-icon {
    width: 24dp;
    height: 24dp;
}

#ins-preview-empty {
    position: absolute;
    left: 0;
    top: 136dp;
    width: 524dp;
    font-size: 13dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2dp;
    text-align: center;
}

#ins-preview-badge {
    display: none;
    position: absolute;
    left: 14dp;
    top: 14dp;
    background-color: #060c16d2;
    border-width: 1dp;
    border-color: #7896c856;
    border-radius: 12dp;
    padding: 4dp 10dp;
    font-size: 11dp;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1.6dp;
}

#ins-name {
    display: block;
    width: 524dp;
    font-size: 20dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.3dp;
    margin-top: 16dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#ins-kindrow {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    margin-top: 8dp;
    margin-bottom: 6dp;
}

#ins-kind {
    font-size: 12dp;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 2.2dp;
}

#ins-ext {
    background-color: #060c16d2;
    border-width: 1dp;
    border-color: #7896c856;
    border-radius: 8dp;
    padding: 3dp 8dp;
    font-size: 11dp;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1dp;
}

#ins-props {
    display: flex;
    flex-direction: column;
    width: 524dp;
    margin-top: 8dp;
}

.ins-prop {
    width: 524dp;
    height: 38dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1dp;
    border-bottom-color: #5a7db41a;
}

.ins-key {
    font-size: 12.5dp;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1.4dp;
    flex-shrink: 0;
    margin-right: 16dp;
}

.ins-val {
    width: 340dp;
    font-size: 13dp;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.3dp;
    text-align: right;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#ins-probing {
    display: none;
    font-size: 13dp;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 2dp;
    margin-top: 14dp;
}

/* =============================== Footer =============================== */

#browser-footer {
    position: absolute;
    bottom: 40dp;
    left: 0;
    width: 1704dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32dp;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
}

.footer-glyph {
    width: 26dp;
    height: 26dp;
    display: inline-block;
}

.glyph-badge {
    width: 38dp;
    height: 38dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 19dp;
    background-color: #14223ab8;
    border-width: 1dp;
    border-color: #7896c838;
}

.glyph-badge-img {
    width: 24dp;
    height: 24dp;
}

.footer-text {
    font-size: 14dp;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1.8dp;
}

#browser-footer-version {
    margin-left: auto;
    font-size: 14dp;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1dp;
}
