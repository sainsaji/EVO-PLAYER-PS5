/* =============================================================================
 * EVO PLAYER PRO - USB Storage Browser
 *
 * Three columns, as in the immediate-mode original: the navigation rail
 * (navbar.rml), the file list, and an inspector showing what the selected
 * file actually is. The list is virtualised — the DOM holds twelve rows and
 * the C side swaps their text as the window moves, so a folder of five
 * thousand files costs exactly what one of five costs.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#browser-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}

/* =============================== Header =============================== */

/* =============================== Header =============================== */

#browser-header {
    position: absolute;
    left: 0;
    top: 72px;
    width: 1704px;
    height: 88px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #5a7db433;
    padding-bottom: 18px;
}

#browser-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#browser-badge {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background-color: #00cdff1a;
    border-width: 1px;
    border-color: #00cdff4d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 22px;
}

#browser-badge-icon {
    width: 34px;
    height: 34px;
}

#browser-header-titles {
    display: flex;
    flex-direction: column;
}

#browser-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

#browser-title {
    display: block;
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 3px;
}

#browser-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: #3ddc84;
}

#browser-path {
    display: block;
    font-size: 14px;
    font-weight: bold;
    color: #a3b6d0;
    letter-spacing: 2px;
    margin-top: 5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 900px;
}

#browser-counter {
    display: block;
    font-size: 14px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2px;
    background-color: #1420368c;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 10px;
    padding: 8px 18px;
}

/* ============================== File list ============================== */

#browser-list {
    position: absolute;
    left: 0;
    top: 200px;
    width: 1116px;
    height: 750px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.brow {
    position: relative;
    width: 1116px;
    height: 80px;
    flex-shrink: 0;
    background-color: #101a2ceb;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 16px;
    margin-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.18s cubic-out, border-color 0.18s cubic-out, background-color 0.18s cubic-out;
}

.brow-focused {
    background-color: #16223af5;
    border-width: 1.5px;
    border-color: #ffcd00;
    transform: scale(1.015);
}

.brow-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.brow-icon-box {
    width: 52px;
    height: 52px;
    background-color: #00cdff14;
    border-width: 1px;
    border-color: #00cdff33;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    transition: background-color 0.18s cubic-out, border-color 0.18s cubic-out;
}

.brow-focused .brow-icon-box {
    background-color: #ffcd001f;
    border-color: #ffcd0073;
}

.brow-icon {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.brow-text {
    display: flex;
    flex-direction: column;
    width: 806px;
}

.brow-name {
    display: block;
    font-size: 22px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.3px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.brow-detail {
    display: block;
    font-size: 13.5px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1.2px;
    margin-top: 3px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.brow-focused .brow-detail {
    color: #ffcd00;
}

.brow-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

.brow-fav {
    width: 24px;
    height: 24px;
    display: none;
}

.brow-badge {
    background-color: #060c16d2;
    border-width: 1px;
    border-color: #7896c856;
    border-radius: 10px;
    padding: 5px 12px;
    font-size: 11.5px;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1.4px;
}

.brow-focused .brow-badge {
    background-color: #ffcd0029;
    border-color: #ffcd00;
    color: #ffcd00;
}

.brow-track {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1116px;
    height: 4px;
    border-radius: 2px;
    background-color: #7896c838;
}

.brow-fill {
    display: block;
    width: 0%;
    height: 4px;
    border-radius: 2px;
    background-color: #ffcd00;
}

/* ============================= Empty state ============================= */

#browser-empty {
    display: none;
    position: absolute;
    left: 0;
    top: 320px;
    width: 1116px;
    flex-direction: column;
    align-items: center;
}

#browser-empty-icon-box {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    background-color: #121b2eeb;
    border-width: 1px;
    border-color: #2a3b55aa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
}

#browser-empty-icon {
    width: 56px;
    height: 56px;
    display: inline-block;
}

#browser-empty-title {
    display: block;
    font-size: 33px;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 1px;
}

#browser-empty-hint {
    display: block;
    font-size: 18px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1px;
    margin-top: 12px;
}

/* ============================== Inspector ============================== */

#inspector {
    position: absolute;
    left: 1140px;
    top: 200px;
    width: 564px;
    height: 750px;
    background-color: #141f348c;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 18px;
    padding: 20px;
    transition: transform 0.2s cubic-out, opacity 0.2s cubic-out;
}

/* 16:9 at the panel's inner width, so a frame from the file is shown at the
 * shape it was shot in rather than letterboxed into a square. */
#ins-preview {
    position: relative;
    width: 524px;
    height: 295px;
    background-color: #0a101cd9;
    border-radius: 14px;
    border-width: 1px;
    border-color: #00cdff29;
    overflow: hidden;
}

#ins-preview-art {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 522px;
    height: 293px;
    border-radius: 12px;
}

#ins-preview-play {
    position: absolute;
    left: 236px;
    top: 121px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: #060c16b8;
    border-width: 1px;
    border-color: #ffffff38;
    display: none;
    align-items: center;
    justify-content: center;
}

#ins-preview-play-icon {
    width: 24px;
    height: 24px;
}

#ins-preview-empty {
    position: absolute;
    left: 0;
    top: 136px;
    width: 524px;
    font-size: 13px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2px;
    text-align: center;
}

#ins-preview-badge {
    display: none;
    position: absolute;
    left: 14px;
    top: 14px;
    background-color: #060c16d2;
    border-width: 1px;
    border-color: #7896c856;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1.6px;
}

#ins-name {
    display: block;
    width: 524px;
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.3px;
    margin-top: 16px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#ins-kindrow {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    margin-bottom: 6px;
}

#ins-kind {
    font-size: 12px;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 2.2px;
}

#ins-ext {
    background-color: #060c16d2;
    border-width: 1px;
    border-color: #7896c856;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: bold;
    color: #cfe0ff;
    letter-spacing: 1px;
}

#ins-props {
    display: flex;
    flex-direction: column;
    width: 524px;
    margin-top: 8px;
}

.ins-prop {
    width: 524px;
    height: 38px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: #5a7db41a;
}

.ins-key {
    font-size: 12.5px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1.4px;
    flex-shrink: 0;
    margin-right: 16px;
}

.ins-val {
    width: 340px;
    font-size: 13px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.3px;
    text-align: right;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#ins-probing {
    display: none;
    font-size: 13px;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 2px;
    margin-top: 14px;
}

/* =============================== Footer =============================== */

#browser-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.footer-glyph {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.glyph-badge {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 19px;
    background-color: #14223ab8;
    border-width: 1px;
    border-color: #7896c838;
}

.glyph-badge-img {
    width: 24px;
    height: 24px;
}

.footer-text {
    font-size: 14px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1.8px;
}

#browser-footer-version {
    margin-left: auto;
    font-size: 14px;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1px;
}
