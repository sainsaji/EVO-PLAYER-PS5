/* =============================================================================
 * EVO PLAYER PRO - Ubuntu Nautilus Media Browser (5-Region Architecture)
 *
 * Visual Architecture:
 * 1. Top Toolbar: Location, Breadcrumb Pills, Search, Counter
 * 2. Left Sidebar: Places (USB, Internal Storage, Favorites, Recent Media, Filters)
 * 3. Main File Area: 2x4 Media Card Grid (Visual Thumbnails / Previews)
 * 4. Bottom Status Strip: Detailed Selection Info & Console Action Hints
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: #1a1a1a;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#browser-pane {
    position: absolute;
    left: 152dp;
    top: 0;
    width: 1768dp;
    height: 1080dp;
}

/* =========================== 1. Top Toolbar =========================== */

#browser-header {
    position: absolute;
    left: 0;
    top: 32dp;
    width: 1704dp;
    height: 56dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#browser-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
}

#browser-badge {
    width: 44dp;
    height: 44dp;
    border-radius: 10dp;
    background-color: #e954201c;
    border-width: 1dp;
    border-color: #e9542066;
    display: flex;
    align-items: center;
    justify-content: center;
}

#browser-badge-icon {
    width: 24dp;
    height: 24dp;
}

#browser-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

#browser-title {
    display: block;
    font-size: 22dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2dp;
}

#browser-live-dot {
    width: 7dp;
    height: 7dp;
    border-radius: 4dp;
    background-color: #e95420;
}

#browser-path {
    display: inline-block;
    background-color: #282828;
    border-width: 1dp;
    border-color: #3e3e3e;
    border-radius: 8dp;
    padding: 6dp 16dp;
    font-size: 13.5dp;
    font-weight: bold;
    color: #dfdbce;
    letter-spacing: 1.2dp;
    max-width: 800dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#browser-header-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
}

#browser-search-pill {
    background-color: #282828;
    border-width: 1dp;
    border-color: #3e3e3e;
    border-radius: 8dp;
    padding: 6dp 12dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.btn-glyph-sm {
    width: 18dp;
    height: 18dp;
}

.search-pill-label {
    font-size: 12.5dp;
    font-weight: bold;
    color: #9e9e9e;
    letter-spacing: 1.2dp;
}

#browser-counter {
    display: block;
    background-color: #282828;
    border-width: 1dp;
    border-color: #3e3e3e;
    border-radius: 8dp;
    padding: 6dp 14dp;
    font-size: 12.5dp;
    font-weight: bold;
    color: #e95420;
    letter-spacing: 1.2dp;
}

/* ============================ 2. Left Sidebar ============================ */

#browser-sidebar {
    position: absolute;
    left: 0;
    top: 104dp;
    width: 270dp;
    height: 856dp;
    background-color: #222222;
    border-width: 1dp;
    border-color: #333333;
    border-radius: 12dp;
    padding: 16dp 10dp;
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

.sb-section-title {
    font-size: 11dp;
    font-weight: bold;
    color: #777777;
    letter-spacing: 1.6dp;
    padding: 6dp 12dp 2dp 12dp;
}

.sb-section-divider {
    height: 1dp;
    background-color: #2c2c2c;
    margin: 8dp 8dp;
}

.sb-item {
    width: 250dp;
    height: 44dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 12dp;
    gap: 12dp;
    background-color: transparent;
    border-width: 1.5dp;
    border-color: transparent;
    transition: background-color 0.15s cubic-out, border-color 0.15s cubic-out;
}

.sb-item-active {
    background-color: #2c2c2c;
    border-color: #3a3a3a;
}

.sb-item-focused {
    background-color: #e9542029;
    border-color: #e95420;
}

.sb-icon {
    width: 22dp;
    height: 22dp;
}

.sb-label {
    font-size: 13.5dp;
    font-weight: bold;
    color: #9e9e9e;
    letter-spacing: 0.8dp;
}

.sb-item-active .sb-label {
    color: #ffffff;
}

.sb-item-focused .sb-label {
    color: #ffffff;
}

/* ========================= 3. Main Media Grid ========================= */

#browser-grid-pane {
    position: absolute;
    left: 290dp;
    top: 104dp;
    width: 1414dp;
    height: 856dp;
    overflow: hidden;
}

#browser-grid {
    width: 1414dp;
    height: 856dp;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16dp;
}

.grid-card {
    width: 341dp;
    height: 418dp;
    background-color: #222222;
    border-width: 1dp;
    border-color: #333333;
    border-radius: 12dp;
    padding: 12dp;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.15s cubic-out, border-color 0.15s cubic-out, background-color 0.15s cubic-out;
}

.grid-card-focused {
    background-color: #2a2a2a;
    border-width: 2.5dp;
    border-color: #e95420;
    transform: scale(1.02);
}

.grid-card-hidden {
    display: none;
}

.card-preview-box {
    width: 317dp;
    height: 184dp;
    background-color: #171717;
    border-radius: 8dp;
    border-width: 1dp;
    border-color: #333333;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.card-preview-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 317dp;
    height: 184dp;
    border-radius: 7dp;
    display: none;
}

.card-preview-icon {
    width: 52dp;
    height: 52dp;
}

.card-badge {
    position: absolute;
    left: 8dp;
    top: 8dp;
    background-color: #1a1a1acc;
    border-width: 1dp;
    border-color: #444444;
    border-radius: 5dp;
    padding: 3dp 8dp;
    font-size: 11dp;
    font-weight: bold;
    color: #dfdbce;
    letter-spacing: 1.2dp;
}

.grid-card-focused .card-badge {
    background-color: #e9542033;
    border-color: #e95420;
    color: #ffffff;
}

.card-fav {
    display: none;
    position: absolute;
    right: 8dp;
    top: 8dp;
    width: 22dp;
    height: 22dp;
}

.card-duration {
    display: none;
    position: absolute;
    right: 8dp;
    bottom: 8dp;
    background-color: #1a1a1ad9;
    border-radius: 4dp;
    padding: 2dp 6dp;
    font-size: 11dp;
    font-weight: bold;
    color: #ffffff;
}

.card-track {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    width: 317dp;
    height: 4dp;
    background-color: #3a3a3a;
}

.card-fill {
    display: block;
    width: 0%;
    height: 4dp;
    background-color: #e95420;
}

.card-meta {
    display: flex;
    flex-direction: column;
    margin-top: 10dp;
    gap: 4dp;
}

.card-title {
    display: block;
    font-size: 18dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.2dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.card-sub {
    display: block;
    font-size: 13dp;
    font-weight: normal;
    color: #9e9e9e;
    margin-top: 2dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.grid-card-focused .card-sub {
    color: #dfdbce;
}

.card-action-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10dp;
    padding-top: 8dp;
    border-top-width: 1dp;
    border-top-color: #2b2b2b;
}

.card-kind {
    font-size: 11.5dp;
    font-weight: bold;
    color: #e95420;
    letter-spacing: 1.2dp;
}

.card-ext {
    background-color: #380c2a80;
    border-width: 1dp;
    border-color: #77216f60;
    border-radius: 4dp;
    padding: 2dp 6dp;
    font-size: 10.5dp;
    font-weight: bold;
    color: #dfdbce;
}

/* ============================ Empty State ============================ */

#browser-empty {
    position: absolute;
    left: 0;
    top: 220dp;
    width: 1414dp;
    display: none;
    flex-direction: column;
    align-items: center;
}

#browser-empty-icon-box {
    width: 108dp;
    height: 108dp;
    border-radius: 54dp;
    background-color: #242424;
    border-width: 1dp;
    border-color: #383838;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20dp;
}

#browser-empty-icon {
    width: 48dp;
    height: 48dp;
}

#browser-empty-title {
    display: block;
    font-size: 26dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 1dp;
}

#browser-empty-hint {
    display: block;
    font-size: 15dp;
    font-weight: normal;
    color: #888888;
    margin-top: 8dp;
}

/* ==================== 4. Bottom Status & Selection Strip ==================== */

#browser-status-strip {
    position: absolute;
    left: 0;
    bottom: 20dp;
    width: 1704dp;
    height: 60dp;
    background-color: #222222;
    border-width: 1dp;
    border-color: #333333;
    border-radius: 12dp;
    padding: 0 18dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

#status-details {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
    max-width: 860dp;
}

.status-name {
    font-size: 17dp;
    font-weight: bold;
    color: #ffffff;
    max-width: 280dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#status-specs {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.status-spec-pill {
    display: none;
    background-color: #2b2b2b;
    border-width: 1dp;
    border-color: #3c3c3c;
    border-radius: 6dp;
    padding: 4dp 10dp;
    font-size: 11.5dp;
    font-weight: bold;
    color: #dfdbce;
}

.status-probing {
    display: none;
    font-size: 12dp;
    font-weight: bold;
    color: #e95420;
    letter-spacing: 1.2dp;
}

#browser-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20dp;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.glyph-badge {
    width: 32dp;
    height: 32dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16dp;
    background-color: #2b2b2b;
    border-width: 1dp;
    border-color: #404040;
}

.glyph-badge-img {
    width: 20dp;
    height: 20dp;
}

.glyph-badge-pill {
    padding: 4dp 9dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10dp;
    background-color: #2b2b2b;
    border-width: 1dp;
    border-color: #404040;
}

.glyph-pill-text {
    font-size: 11dp;
    font-weight: bold;
    color: #e95420;
}

.footer-text {
    font-size: 12.5dp;
    font-weight: bold;
    color: #9e9e9e;
    letter-spacing: 1.2dp;
}

#browser-footer-version {
    font-size: 12dp;
    font-weight: bold;
    color: #555555;
    margin-left: 10dp;
}
