}

.tv-detail-epg-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
}

.tv-detail-epg-badge {
    font-size: 10.5dp;
    font-weight: bold;
    color: #7ce4ff;
    background-color: #00cdff1a;
    border-width: 1dp;
    border-color: #00cdff4d;
