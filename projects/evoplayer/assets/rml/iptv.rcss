}

.tv-detail-badge-next {
    color: #c2d2e8;
    background-color: #5a7db426;
    border-color: #5a7db44d;
}

.tv-detail-epg-text {
    font-size: 13dp;
    color: #c2d2e8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 340dp;
}

.tv-detail-action {
    tab-index: auto;
    nav: auto;
    width: 100%;
    height: 48dp;
    background-color: #00cdff;
    border-radius: 12dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10dp;
    transition: transform 0.15s cubic-out, background-color 0.15s cubic-out;
}

.tv-detail-action:focus {
    background-color: #38dcff;
    border-width: 2dp;
    border-color: #ffffff;
    transform: scale(1.02);
}

.tv-detail-glyph-box {
    width: 22dp;
    height: 22dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tv-detail-glyph {
    width: 16dp;
    height: 16dp;
}

.tv-detail-action-text {
    font-size: 15dp;
    font-weight: bold;
    color: #06090e;
    letter-spacing: 1.2dp;
}

.tv-detail-paging {
    text-align: center;
    margin-top: 6dp;
}

.tv-detail-page-hint {
    font-size: 11.5dp;
    color: #5a7db4;
    letter-spacing: 0.5dp;
}

/* ========================== 3. Status strip ========================== */

#tv-status-strip {
    position: absolute;
    left: 0;
    bottom: 20dp;
    width: 1704dp;
    height: 60dp;
    background-color: #0b1220a3;
    backdrop-filter: blur(22dp);
    border-width: 1dp;
    border-color: #5a7db44d;
    border-radius: 16dp;
    padding: 0 18dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

#tv-status-details {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14dp;
    max-width: 700dp;
}

#tv-source-name {
    font-size: 17dp;
    font-weight: bold;
    color: #ffffff;
    max-width: 280dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.tv-spec-pill {
    background-color: #101c30;
    border-width: 1dp;
    border-color: #5a7db44d;
    border-radius: 8dp;
    padding: 4dp 10dp;
    font-size: 11.5dp;
    font-weight: bold;
    color: #c2d2e8;
    letter-spacing: 1.2dp;
    max-width: 320dp;
    white-space: nowrap;
    text-overflow: ellipsis;
}

@keyframes tv-spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

@keyframes tv-pulse {
    from {
        opacity: 0.4;
    }
    to {
        opacity: 1.0;
    }
}

.tv-spinner {
    display: inline-block;
    width: 48dp;
    height: 48dp;
    border-radius: 24dp;
    border-width: 4dp;
    border-color: #00cdff33;
    border-top-color: #00cdff;
    animation: 0.8s linear infinite tv-spin;
}

.tv-spinner-sm {
    display: inline-block;
    width: 16dp;
    height: 16dp;
    border-radius: 8dp;
    border-width: 2.5dp;
    border-color: #00cdff33;
    border-top-color: #00cdff;
    animation: 0.8s linear infinite tv-spin;
}

#tv-tuning-indicator {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    background-color: #00cdff1a;
    border-width: 1dp;
    border-color: #00cdff4d;
    border-radius: 8dp;
    padding: 3dp 10dp;
}

#tv-tuning {
    font-size: 12dp;
    font-weight: bold;
    color: #00cdff;
    letter-spacing: 1.2dp;
}

/* Centered tuning overlay while connecting to stream */
#tv-tuning-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 1704dp;
    height: 856dp;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
}

#tv-tuning-card {
    width: 440dp;
    padding: 36dp 28dp;
    background-color: #0b1220f2;
    backdrop-filter: blur(28dp);
    border-width: 1.5dp;
    border-color: #00cdff80;
    border-radius: 20dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16dp;
}

#tv-tuning-title {
    font-size: 20dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2dp;
}

#tv-tuning-subtitle {
    font-size: 13.5dp;
    color: #7e97b8;
    text-align: center;
    letter-spacing: 0.5dp;
}

#tv-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20dp;
}

.tv-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.tv-glyph {
    width: 32dp;
    height: 32dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16dp;
    background-color: #101c30;
    border-width: 1dp;
    border-color: #5a7db44d;
}

.tv-glyph-img {
    width: 20dp;
    height: 20dp;
}

.tv-glyph-pill {
    padding: 4dp 9dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10dp;
    background-color: #101c30;
    border-width: 1dp;
    border-color: #5a7db44d;
}

.tv-glyph-pill-text {
    font-size: 11dp;
    font-weight: bold;
    color: #00cdff;
}

.tv-hint-text {
    font-size: 12.5dp;
    font-weight: bold;
    color: #8ea4c8;
    letter-spacing: 1.2dp;
}
