/* =============================================================================
 * EVO PLAYER PRO - Netflix Confirmation & Modal Dialog Stylesheet (RCSS)
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Fullscreen Dimmed Scrim */
#dialog-scrim {
    width: 1920px;
    height: 1080px;
    background-color: #000000b8;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Dialog Container Card */
#dialog-card {
    width: 920px;
    background-color: #0c1018fc;
    border-width: 1px;
    border-color: #222d3e;
    border-radius: 16px;
    padding: 40px 48px;
    display: flex;
    flex-direction: column;
}

#dialog-eyebrow {
    font-size: 13px;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1.5px;
}

#dialog-title {
    font-size: 30px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-top: 8px;
}

#dialog-detail {
    font-size: 15px;
    font-weight: bold;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin-top: 6px;
}

/* Progress Bar */
#dialog-progress-track {
    width: 824px;
    height: 6px;
    background-color: #242c3d;
    border-radius: 3px;
    margin-top: 24px;
    position: relative;
}

#dialog-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 6px;
    background-color: #e50914;
    border-radius: 3px;
}

/* Actions Row */
#dialog-actions-row {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-top: 36px;
}

.action-btn {
    padding: 12px 28px;
    border-radius: 24px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.btn-primary {
    background-color: #e50914;
    color: #ffffff;
}

.btn-secondary {
    background-color: #1a2336;
    border-width: 1px;
    border-color: #2e3e5c;
    color: #e2e8f0;
}

.btn-glyph {
    width: 22px;
    height: 22px;
    display: inline-block;
}

.btn-text {
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.action-hidden {
    display: none;
}
