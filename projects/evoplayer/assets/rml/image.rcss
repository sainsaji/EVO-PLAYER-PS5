/* GL-5 (#81): full-screen photo / image viewer. Replaces main.c's
 * draw_image_screen + draw_bmp_to_fb. The decoded RGBA is fed as a memory
 * texture and drawn as a `contain`-fit decorator on #img-canvas. */

body {
    font-family: LatoLatin;
    font-weight: normal;
    color: #ffffff;
    background-color: #06090e;
    width: 1920px;
    height: 1080px;
    margin: 0;
    padding: 0;
}

#img-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 168px;
    padding: 58px 82px 0 82px;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
}

#img-accent {
    width: 5px;
    height: 76px;
    background-color: #00d7ffe1;
    margin-right: 34px;
}

#img-head-text {
    display: flex;
    flex-direction: column;
}

#img-eyebrow {
    font-size: 30px;
    font-weight: bold;
    color: #e8f4fff0;
    letter-spacing: 1px;
}

#img-title {
    font-size: 16px;
    font-weight: bold;
    color: #00cdfae1;
    letter-spacing: 0.5px;
    margin-top: 10px;
    max-width: 1200px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#img-dims {
    margin-left: auto;
    font-size: 15px;
    font-weight: bold;
    color: #87c3e1d2;
    letter-spacing: 0.5px;
}

#img-frame {
    position: absolute;
    left: 150px;
    top: 192px;
    width: 1620px;
    height: 690px;
    background-color: #010814e6;
    border-width: 1px;
    border-color: #00bef5af;
    border-radius: 30px;
    padding: 38px;
}

#img-canvas {
    display: block;
    width: 1544px;
    height: 614px;
    background-color: #00020899;
    decorator: image(none contain);
}

#img-error {
    display: none;
    width: 1544px;
    height: 614px;
    background-color: #00020899;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#img-error-title {
    font-size: 26px;
    font-weight: bold;
    color: #e8f4ffe6;
    letter-spacing: 0.5px;
}

#img-error-sub {
    font-size: 15px;
    font-weight: bold;
    color: #7dc6e4d7;
    letter-spacing: 0.5px;
    margin-top: 14px;
}

#img-footer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1920px;
    height: 79px;
    padding: 0 82px;
    background-color: #00071289;
    border-top-width: 1px;
    border-top-color: #0096ff30;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.img-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

.glyph-badge {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img { width: 20px; height: 20px; }

.img-hint-text {
    font-size: 14px;
    font-weight: bold;
    color: #afd1dccd;
    letter-spacing: 0.5px;
}

.img-muted { color: #87c3e1cd; }
