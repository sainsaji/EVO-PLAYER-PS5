<rml>
<head>
    <link type="text/rcss" href="settings.rcss"/>
</head>
<body id="settings-body">
    <!-- Navigation rail is rendered via the standalone navbar.rml overlay -->

    <!--
      Two-pane settings, macOS System Settings shape: a frosted sidebar listing
      the four sections over a wallpaper, and a detail pane whose rows are
      grouped into one frosted card.  The wallpaper exists so the glass has
      something to refract - backdrop-filter over a flat fill is a no-op.
    -->
    <div id="settings-wallpaper"></div>
    <div id="settings-scrim"></div>

    <div id="settings-shell">
        <!-- ================= Sidebar (frosted) ================= -->
        <div id="settings-sidebar">
            <div id="sidebar-brand">
                <div id="settings-badge">
                    <img id="settings-badge-icon" src="../icons/icon_settings.png"/>
                </div>
                <div id="sidebar-brand-text">
                    <div id="sidebar-brand-name">SETTINGS</div>
                    <div id="sidebar-brand-sub">PREFERENCES</div>
                </div>
            </div>
            <div id="sidebar-divider"></div>
            <div id="sb-0" class="sb-section">
                <div class="sb-icon-box">
                    <img id="sb-icon-0" src="../icons/icon_resume.png" class="sb-icon"/>
                </div>
                <div class="sb-text">
                    <div id="sb-label-0" class="sb-label">PLAYBACK &amp; VIDEO</div>
                    <div id="sb-sub-0" class="sb-sub">Aspect, resume &amp; decoder</div>
                </div>
            </div>
            <div id="sb-1" class="sb-section">
                <div class="sb-icon-box">
                    <img id="sb-icon-1" src="../icons/icon_subtitles.png" class="sb-icon"/>
                </div>
                <div class="sb-text">
                    <div id="sb-label-1" class="sb-label">SUBTITLES</div>
                    <div id="sb-sub-1" class="sb-sub">Auto-detect &amp; sizing</div>
                </div>
            </div>
            <div id="sb-2" class="sb-section">
                <div class="sb-icon-box">
                    <img id="sb-icon-2" src="../icons/icon_palette.png" class="sb-icon"/>
                </div>
                <div class="sb-text">
                    <div id="sb-label-2" class="sb-label">INTERFACE &amp; CONTROLS</div>
                    <div id="sb-sub-2" class="sb-sub">Themes, sounds &amp; sorting</div>
                </div>
            </div>
            <div id="sb-3" class="sb-section">
                <div class="sb-icon-box">
                    <img id="sb-icon-3" src="../icons/icon_developer_tools.png" class="sb-icon"/>
                </div>
                <div class="sb-text">
                    <div id="sb-label-3" class="sb-label">SYSTEM &amp; DIAGNOSTICS</div>
                    <div id="sb-sub-3" class="sb-sub">Developer tools &amp; tile</div>
                </div>
            </div>
        </div>

        <!-- ================= Detail pane ================= -->
        <div id="settings-detail">
            <div id="settings-header">
                <div id="header-left">
                    <div id="header-titles">
                        <div id="settings-title-row">
                            <span id="settings-title">SETTINGS</span>
                            <span id="settings-live-dot"></span>
                        </div>
                        <div id="settings-subtitle">APPLICATION &amp; PLAYBACK PREFERENCES</div>
                    </div>
                </div>
                <div id="settings-counter">1 OF 4</div>
            </div>

            <!-- One frosted group card; rows are separated by hairlines -->
            <div id="settings-list">
                <div id="row-0" class="setting-row row-focused">
                    <div class="row-left">
                        <div id="row-iconbox-0" class="row-icon-box">
                            <img id="row-icon-0" src="../icons/icon_resume.png" class="row-icon"/>
                        </div>
                        <div class="row-text-box">
                            <div id="row-title-0" class="row-title"></div>
                            <div id="row-detail-0" class="row-detail"></div>
                        </div>
                    </div>
                    <div class="row-right">
                        <div id="row-badge-0" class="row-badge badge-hidden"></div>
                        <div id="row-toggle-0" class="row-toggle">
                            <div class="row-knob"></div>
                        </div>
                        <div id="row-check-0" class="row-check"></div>
                        <img id="row-chevron-0" src="../icons/icon_chevron.png" class="row-chevron"/>
                    </div>
                </div>
                <div id="row-1" class="setting-row">
                    <div class="row-left">
                        <div id="row-iconbox-1" class="row-icon-box">
                            <img id="row-icon-1" src="../icons/icon_subtitles.png" class="row-icon"/>
                        </div>
                        <div class="row-text-box">
                            <div id="row-title-1" class="row-title"></div>
                            <div id="row-detail-1" class="row-detail"></div>
                        </div>
                    </div>
                    <div class="row-right">
                        <div id="row-badge-1" class="row-badge badge-hidden"></div>
                        <div id="row-toggle-1" class="row-toggle">
                            <div class="row-knob"></div>
                        </div>
                        <div id="row-check-1" class="row-check"></div>
                        <img id="row-chevron-1" src="../icons/icon_chevron.png" class="row-chevron"/>
                    </div>
                </div>
                <div id="row-2" class="setting-row">
                    <div class="row-left">
                        <div id="row-iconbox-2" class="row-icon-box">
                            <img id="row-icon-2" src="../icons/icon_palette.png" class="row-icon"/>
                        </div>
                        <div class="row-text-box">
                            <div id="row-title-2" class="row-title"></div>
                            <div id="row-detail-2" class="row-detail"></div>
                        </div>
                    </div>
                    <div class="row-right">
                        <div id="row-badge-2" class="row-badge badge-hidden"></div>
                        <div id="row-toggle-2" class="row-toggle">
