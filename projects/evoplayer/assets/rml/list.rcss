/* =============================================================================
 * EVO PLAYER PRO - Generic scrolling list screen
 *
 * RECENT, FAVORITES, EMBY SETUP and EMBY BROWSE. All four are evo_list_model
 * in the immediate-mode UI, so they share one document here rather than four
 * near-identical ones. Geometry and type follow settings.rcss so a user
 * moving between sections sees one interface, not four.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Content pane at EVO_CONTENT_X, clear of the rail by the native 44 px. */
#list-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}

/* =============================== Header =============================== */

#list-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 96px;
    margin-bottom: 42px;
    width: 1704px;
}

#list-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#list-indicator {
    width: 5px;
    height: 62px;
    background-color: #00cdff;
    border-radius: 2px;
    margin-right: 18px;
}

#list-header-titles {
    display: flex;
    flex-direction: column;
}

#list-title {
    font-size: 43px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
}

#list-subtitle {
    font-size: 15px;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1px;
    margin-top: 3px;
}

#list-counter {
    font-size: 15px;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

/* ================================ Rows ================================ */

#list-rows {
    display: flex;
    flex-direction: column;
    width: 1704px;
}

/* EVO_ROW_H on EVO_ROW_PITCH, the same geometry the immediate-mode list
 * used. The focus model's capacity is derived from those constants, so a
 * shorter row here would scroll out of step with the cursor. */
.list-row {
    width: 1704px;
    height: 92px;
    background-color: #121b2eeb;
    border-width: 1px;
    border-color: #2a3b55aa;
    border-radius: 20px;
    margin-bottom: 12px;
    padding-left: 32px;
    padding-right: 32px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.list-row-focused {
    background-color: #1b2e4cf5;
    border-width: 1.5px;
    border-color: #00cdff;
}

.lrow-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.lrow-icon-box {
    width: 60px;
    height: 60px;
    background-color: #131c2e;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.list-row-focused .lrow-icon-box {
    background-color: #1a2a47;
}

.lrow-icon {
    width: 30px;
    height: 30px;
    display: inline-block;
}

.lrow-text {
    display: flex;
    flex-direction: column;
    width: 1384px;
}

.lrow-title {
    display: block;
    font-size: 33px;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 0.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.lrow-detail {
    display: block;
    font-size: 18px;
    font-weight: normal;
    color: #9fb2cc;
    letter-spacing: 0.5px;
    margin-top: 3px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Resume position, for RECENT. Sits under the detail line rather than beside
 * it, so a long filename never has to share the row with it. */
.lrow-track {
    display: block;
    width: 460px;
    height: 5px;
    border-radius: 2px;
    background-color: #2a3b5599;
    margin-top: 7px;
}

.lrow-fill {
    display: block;
    width: 0%;
    height: 5px;
    border-radius: 2px;
    background-color: #00cdff;
}

.lrow-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.lrow-badge {
    background-color: #131d2e;
    border-width: 1px;
    border-color: #243550;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 15px;
    font-weight: bold;
    color: #9fb2cc;
    letter-spacing: 0.5px;
    margin-right: 16px;
}

.lrow-chevron {
    width: 20px;
    height: 20px;
    display: inline-block;
}

/* ============================= Empty state ============================= */

#list-empty {
    display: none;
    position: absolute;
    left: 0;
    top: 300px;
    width: 1704px;
    flex-direction: column;
    align-items: center;
}

#list-empty-icon-box {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    background-color: #121b2eeb;
    border-width: 1px;
    border-color: #2a3b55aa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
}

#list-empty-icon {
    width: 56px;
    height: 56px;
    display: inline-block;
}

#list-empty-title {
    display: block;
    font-size: 33px;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 1px;
}

#list-empty-hint {
    display: block;
    font-size: 18px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1px;
    margin-top: 12px;
}

/* =============================== Footer =============================== */

#list-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.footer-glyph {
    width: 30px;
    height: 30px;
    display: inline-block;
}

.glyph-badge {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 21px;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 28px;
    height: 28px;
}

.footer-text {
    font-size: 15px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1px;
}

#list-footer-version {
    margin-left: auto;
    font-size: 15px;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1px;
}
