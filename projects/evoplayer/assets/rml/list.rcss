/* =============================================================================
 * EVO PLAYER PRO - Generic scrolling list screen
 *
 * RECENT, FAVORITES, EMBY SETUP and EMBY BROWSE. All four are evo_list_model
 * in the immediate-mode UI, so they share one document here rather than four
 * near-identical ones. Geometry and type follow settings.rcss so a user
 * moving between sections sees one interface, not four.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16px;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920px;
    height: 1080px;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

/* Content pane at EVO_CONTENT_X, clear of the rail by the native 44 px. */
#list-pane {
    position: absolute;
    left: 152px;
    top: 0;
    width: 1768px;
    height: 1080px;
}

/* =============================== Header =============================== */

#list-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 72px;
    margin-bottom: 36px;
    width: 1704px;
    height: 88px;
}

#list-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#list-indicator {
    width: 4px;
    height: 52px;
    background-color: #00cdff;
    border-radius: 2px;
    margin-right: 18px;
}

#list-header-titles {
    display: flex;
    flex-direction: column;
}

#list-title {
    font-size: 32px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2px;
}

#list-subtitle {
    font-size: 14px;
    font-weight: bold;
    color: #a3b6d0;
    letter-spacing: 1.5px;
    margin-top: 5px;
}

#list-counter {
    font-size: 13px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 2px;
    background-color: #1420368c;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 10px;
    padding: 8px 18px;
}

/* ================================ Rows ================================ */

#list-rows {
    display: flex;
    flex-direction: column;
    width: 1704px;
}

.list-row {
    width: 1704px;
    height: 84px;
    background-color: #101a2ceb;
    border-width: 1px;
    border-color: #5a7db429;
    border-radius: 16px;
    margin-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition: transform 0.18s cubic-out, border-color 0.18s cubic-out, background-color 0.18s cubic-out;
}

.list-row-focused {
    background-color: #16223af5;
    border-width: 1.5px;
    border-color: #ffcd00;
    transform: scale(1.012);
}

.lrow-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.lrow-icon-box {
    width: 52px;
    height: 52px;
    background-color: #00cdff14;
    border-width: 1px;
    border-color: #00cdff33;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 18px;
    transition: background-color 0.18s cubic-out, border-color 0.18s cubic-out;
}

.list-row-focused .lrow-icon-box {
    background-color: #ffcd001f;
    border-color: #ffcd0073;
}

.lrow-icon {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.lrow-text {
    display: flex;
    flex-direction: column;
    width: 1384px;
}

.lrow-title {
    display: block;
    font-size: 22px;
    font-weight: bold;
    color: #eef4ff;
    letter-spacing: 0.4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.lrow-detail {
    display: block;
    font-size: 13.5px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 0.6px;
    margin-top: 4px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.list-row-focused .lrow-detail {
    color: #ffcd00;
}

/* Resume position, for RECENT. Sits under the detail line rather than beside
 * it, so a long filename never has to share the row with it. */
.lrow-track {
    display: block;
    width: 460px;
    height: 4px;
    border-radius: 2px;
    background-color: #7896c838;
    margin-top: 6px;
}

.lrow-fill {
    display: block;
    width: 0%;
    height: 4px;
    border-radius: 2px;
    background-color: #ffcd00;
}

.lrow-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.lrow-badge {
    background-color: #0a101c99;
    border-width: 1px;
    border-color: #5a7db433;
    border-radius: 10px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: bold;
    color: #7c8ba3;
    letter-spacing: 1.4px;
    margin-right: 16px;
}

.list-row-focused .lrow-badge {
    background-color: #ffcd0029;
    border-color: #ffcd00;
    color: #ffcd00;
}

.lrow-chevron {
    width: 20px;
    height: 20px;
    display: inline-block;
}

/* ============================= Empty state ============================= */

#list-empty {
    display: none;
    position: absolute;
    left: 0;
    top: 300px;
    width: 1704px;
    flex-direction: column;
    align-items: center;
}

#list-empty-icon-box {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    background-color: #121b2eeb;
    border-width: 1px;
    border-color: #2a3b55aa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
}

#list-empty-icon {
    width: 56px;
    height: 56px;
    display: inline-block;
}

#list-empty-title {
    display: block;
    font-size: 33px;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 1px;
}

#list-empty-hint {
    display: block;
    font-size: 18px;
    font-weight: bold;
    color: #5e718c;
    letter-spacing: 1px;
    margin-top: 12px;
}

/* =============================== Footer =============================== */

#list-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: 1704px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32px;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.footer-glyph {
    width: 26px;
    height: 26px;
    display: inline-block;
}

.glyph-badge {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 19px;
    background-color: #14223ab8;
    border-width: 1px;
    border-color: #7896c838;
}

.glyph-badge-img {
    width: 24px;
    height: 24px;
}

.footer-text {
    font-size: 14px;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1.8px;
}

#list-footer-version {
    margin-left: auto;
    font-size: 14px;
    font-weight: bold;
    color: #4b586c;
    letter-spacing: 1px;
}
