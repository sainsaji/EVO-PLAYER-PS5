/* =============================================================================
 * EVO Player - Side Navigation Rail (navbar.rcss)
 * Standalone overlay rendered on top of every RML screen that needs a rail.
 * Collapsed: 96 px icon strip. Expanded (rail_focused): 240 px labelled panel.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-size: 15dp;
    color: #ffffff;
    background-color: transparent;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span {
    box-sizing: border-box;
}

/* ---- Collapsed rail background band ---- */
/* Menu FPS pill - top-right, matching the player's #fps-pill placement.
 * Hidden unless the DEBUG OVERLAY setting is on. */
#nav-fps-pill {
    display: none;
    position: absolute;
    top: 12dp;
    right: 12dp;
    padding: 5dp 12dp;
    border-radius: 12dp;
    border-width: 1dp;
    border-color: #ffffff29;
    background-color: #06090ecc;
    z-index: 50;
}

#nav-fps-value {
    font-size: 14dp;
    font-weight: bold;
    color: #2ecc71;
    letter-spacing: 1dp;
}

#nav-rail-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 108dp;
    height: 1080dp;
    background-color: #060a14b8;
    border-right-width: 1dp;
    border-right-color: #5a7db433;
}

/* ---- EVO logo mark (collapsed) ---- */
#nav-logo {
    position: absolute;
    left: 0;
    top: 22dp;
    width: 108dp;
    height: 52dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

#nav-logo-img {
    width: 38dp;
    height: 38dp;
    display: inline-block;
}

/* ---- Collapsed icon items ---- */
#nav-items {
    position: absolute;
    left: 0;
    top: 88dp;
    width: 108dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6dp;
    padding-top: 2dp;
}

/* ---- QUIT EVO, pinned to the foot of the rail ----
 * Same 54dp wrap as a section; 1080 - 54 - 26 puts it 26dp off the bottom. */
#nav-quit {
    position: absolute;
    left: 0;
    top: 1000dp;
    width: 108dp;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.rail-item-wrap {
    position: relative;
    width: 108dp;
    height: 54dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Accent bar on the left edge of active item */
.rail-accent-bar {
    position: absolute;
    left: 0dp;
    top: 14dp;
    width: 4dp;
    height: 26dp;
    border-radius: 2dp;
    background-color: #00cdff;
    display: none;
}

.rail-accent-bar-visible {
    display: block;
}

.rail-item {
    width: 84dp;
    height: 50dp;
    border-radius: 14dp;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0dp;
    border-color: transparent;
    transition: transform 0.18s cubic-out, background-color 0.18s cubic-out;
}

.rail-item-active {
    background-color: #263e64b8;
    border-width: 1dp;
    border-color: #5a7db44d;
}

.rail-item-cursor {
    background-color: #00cdffd9;
    border-width: 1dp;
    border-color: #ffffff;
    transform: scale(1.06);
}

.rail-icon {
    width: 34dp;
    height: 34dp;
    display: inline-block;
}

/* ============================================================
   Expanded overlay (rail_focused = true)
   ============================================================ */

/* Scrim dims the content to the right of the rail */
#nav-scrim {
    display: none;
    position: absolute;
    left: 108dp;
    top: 0;
    width: 1812dp;
    height: 1080dp;
    background-color: #020409a8;
}

/* Full expanded panel */
#nav-expanded {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 300dp;
    height: 1080dp;
    background-color: #060b16ff;
    border-right-width: 1dp;
    border-right-color: #1e2f47;
}

#nav-expanded-logo {
    position: absolute;
    left: 0;
    top: 22dp;
    width: 108dp;
    height: 52dp;
    display: flex;
    align-items: center;
    justify-content: center;
}

#nav-expanded-logo-img {
    width: 38dp;
    height: 38dp;
    display: inline-block;
}

#nav-app-label {
    position: absolute;
    left: 120dp;
    top: 30dp;
    font-size: 28dp;
    font-weight: bold;
    color: #ecf3ff;
    letter-spacing: 3dp;
}

/* Expanded items list */
#nav-expanded-items {
    position: absolute;
    left: 12dp;
    top: 90dp;
    width: 276dp;
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

#nav-expanded-quit {
    position: absolute;
    left: 12dp;
    top: 988dp;
    width: 276dp;
    padding-top: 12dp;
    border-top-width: 1dp;
    border-top-color: #1e2f47;
}

.rail-exp-item {
    width: 276dp;
    height: 52dp;
    border-radius: 16dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 12dp;
    padding-right: 12dp;
    gap: 14dp;
    background-color: transparent;
    border-width: 0dp;
    border-color: transparent;
}

.rail-exp-item-active {
    background-color: #1b2e4caa;
    border-width: 1dp;
    border-color: #2a3b55aa;
}

.rail-exp-item-cursor {
    background-color: #00cdffe6;
    border-width: 1dp;
    border-color: #ffffff;
}

.rail-exp-icon {
    width: 30dp;
    height: 30dp;
    display: inline-block;
}

.rail-exp-label {
    font-size: 19dp;
    font-weight: bold;
    color: #9fb2cc;
    letter-spacing: 1dp;
}

/*
 * Elevated-privileges banner - shown whenever the per-title sandbox has not
 * been lifted, which means /mnt/usb0 and /data are both invisible and the
 * player can see no media at all.
 *
 * Amber rather than the theme accent: this is not a themed piece of chrome, it
 * is a fault, and it should not recolour into something that reads as
 * decoration when the user picks Ember. Top-centre keeps it clear of the FPS
 * pill (top-right), the clock (also right) and the button hints along the
 * bottom of every screen.
 */
#nav-privilege-banner {
    display: none;
    position: absolute;
    top: 14dp;
    left: 430dp;
    width: 1060dp;
    padding: 9dp 18dp;
    border-radius: 10dp;
    border-width: 1dp;
    border-color: #ffb02499;
    background-color: #2a1c05f2;
    flex-direction: row;
    align-items: center;
    z-index: 60;
}

#nav-privilege-title {
    font-size: 15dp;
    font-weight: bold;
    color: #ffb024;
    letter-spacing: 1dp;
    margin-right: 14dp;
}

#nav-privilege-hint {
    font-size: 14dp;
    font-weight: normal;
    color: #d8c6a4;
}
