/* =============================================================================
 * EVO PLAYER PRO - Text reader
 *
 * A single scrolling pane: header, a column of pre-wrapped lines, a
 * scrollbar in the gutter, and an optional footnote. Geometry follows
 * changelog.rcss / list.rcss so this reads as the same app, not a bolt-on.
 * ============================================================================= */

body {
    font-family: LatoLatin;
    font-weight: normal;
    font-size: 16dp;
    color: #ffffff;
    background-color: #06090e;
    margin: 0;
    padding: 0;
    width: 1920dp;
    height: 1080dp;
    overflow: hidden;
    position: relative;
}

div, span, p {
    box-sizing: border-box;
}

#reader-pane {
    position: absolute;
    left: 152dp;
    top: 0;
    width: 1768dp;
    height: 1080dp;
}

/* =============================== Header =============================== */

#reader-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 96dp;
    margin-bottom: 42dp;
    width: 1704dp;
}

#reader-header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#reader-indicator {
    width: 5dp;
    height: 62dp;
    background-color: #00cdff;
    border-radius: 2dp;
    margin-right: 18dp;
}

#reader-header-titles {
    display: flex;
    flex-direction: column;
}

#reader-title {
    display: block;
    font-size: 34dp;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.3dp;
}

#reader-subtitle {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1dp;
    margin-top: 3dp;
}

#reader-badge {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #8fa0b5;
    letter-spacing: 1dp;
    margin-bottom: 6dp;
}

/* ================================ Notice ================================ */

/* An error, or an empty file. Centred in the content area rather than a
 * toast: the page has nothing else on it, and a toast would be gone before
 * the reader worked out why the screen was blank. */
#reader-notice {
    display: none;
    position: absolute;
    left: 0;
    top: 550dp;
    width: 1704dp;
    font-size: 22dp;
    font-weight: normal;
    text-align: center;
}

/* ================================ Lines ================================ */

#reader-lines {
    position: absolute;
    left: 0;
    top: 222dp;
    width: 1670dp;
    height: 700dp;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.rline {
    display: block;
    width: 1670dp;
    font-weight: normal;
    letter-spacing: 0.2dp;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* Three reading sizes, cycled with TRIANGLE - matches EVO_FACE_SMALL /
 * EVO_FACE_SUB / EVO_FACE_MENU in the legacy renderer (reader_face_h). */
.rline-face-0 {
    height: 24dp;
    font-size: 16dp;
}

.rline-face-1 {
    height: 30dp;
    font-size: 20dp;
}

.rline-face-2 {
    height: 36dp;
    font-size: 26dp;
}

/* =============================== Scrollbar =============================== */

#reader-scrollbar {
    display: flex;
    position: absolute;
    left: 1684dp;
    top: 222dp;
    width: 6dp;
    height: 700dp;
    border-radius: 3dp;
    border-width: 1dp;
}

#reader-scrollbar-thumb {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 6dp;
    height: 100%;
    border-radius: 3dp;
}

/* ================================ Footnote ================================ */

#reader-footnote {
    display: none;
    position: absolute;
    left: 0;
    top: 934dp;
    width: 1704dp;
    font-size: 14dp;
    font-weight: bold;
    letter-spacing: 0.5dp;
}

/* =============================== Footer =============================== */

#reader-footer {
    position: absolute;
    bottom: 40dp;
    left: 0;
    width: 1704dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 32dp;
}

.footer-hint {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.glyph-badge {
    width: 42dp;
    height: 42dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 21dp;
    background-color: rgba(20, 40, 80, 0.9);
}

.glyph-badge-img {
    width: 28dp;
    height: 28dp;
}

.footer-text {
    font-size: 15dp;
    font-weight: bold;
    color: #8b99ad;
    letter-spacing: 1dp;
}
