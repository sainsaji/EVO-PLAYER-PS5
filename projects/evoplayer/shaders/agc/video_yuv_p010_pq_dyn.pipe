; video_yuv_p010_pq_dyn - P010 HDR10 / DV base layer -> HDR10 output, fitted to the panel peak
; Generated by tools/gen_video_pipes.py. Edit the generator, not this file.
;
; Fullscreen quad built from gl_VertexIndex, so there is no vertex buffer and no
; [VertexInputState]. Fragment samplers live at set 1 because the vertex stage
; already owns set 0 binding 0 for its uniform block.

[Version]
version = 65

[VsGlsl]
#version 450

layout(set = 0, binding = 0, std140) uniform VideoConstants {
    vec2 uCrop;
    vec2 uScale;
    float uBlack;   /* Deep Blacks (#119): floor, toe knee, toe slope. All 0 = off. */
    float uKnee;
    float uSlope;
} video;

layout(location = 0) out vec2 vUV;
layout(location = 1) flat out vec3 vDeep;

void main() {
    vec2 p = vec2(float(gl_VertexIndex & 1), float((gl_VertexIndex >> 1) & 1));
    vUV = vec2(p.x, 1.0 - p.y) * video.uCrop;
    vDeep = vec3(video.uBlack, video.uKnee, video.uSlope);
    gl_Position = vec4((p * 2.0 - 1.0) * video.uScale, 0.0, 1.0);
}

[VsInfo]
entryPoint = main

[FsGlsl]
#version 450

layout(set = 1, binding = 0) uniform sampler2D uY;
layout(set = 1, binding = 1) uniform sampler2D uUV;

layout(location = 0) in vec2 vUV;
layout(location = 0) out vec4 out_color;

layout(set = 1, binding = 2, std140) uniform DoviParams {
    vec4 ycc[3];
    vec4 off;
    vec4 lms[3];
    vec4 lohi[3];
} dv;

vec3 yuv2020(float y, float u, float v) {
    float Yp = (y - 0.062561095) * 1.167808219;
    float U = (u - 0.500488759) * 1.141741071;
    float V = (v - 0.500488759) * 1.141741071;
    return vec3(Yp + 1.474600 * V,
                Yp + (-0.164553) * U + (-0.571353) * V,
                Yp + 1.881400 * U);
}

/*
 * HDR peak mapping (EVO "HDR peak" setting). BT.2390 EETF in the PQ domain on
 * max(R,G,B), applied as one gain to all three channels so hue and saturation
 * survive. `src` is the brightest the picture gets (Dolby Vision L1 max per
 * shot, else the HDR10 MaxCLL / mastering peak), `dst` the panel peak. Below
 * the knee and whenever src <= dst it is the identity.
 */
float hm_pq(float nits) {
    float Y = pow(clamp(nits / 10000.0, 0.0, 1.0), 0.1593017578125);
    return pow((0.8359375 + 18.8515625 * Y) / (1.0 + 18.6875 * Y), 78.84375);
}

float hm_nits(float N) {
    float Np = pow(max(N, 0.0), 1.0 / 78.84375);
    return 10000.0 * pow(max(Np - 0.8359375, 0.0) / (18.8515625 - 18.6875 * Np),
                         1.0 / 0.1593017578125);
}

vec3 hdr_peak_map(vec3 nits, float src, float dst) {
    if (dst <= 0.0 || src <= dst)
        return nits;
    float m = max(max(nits.r, nits.g), nits.b);
    if (m <= 0.0)
        return nits;
    float maxLum = hm_pq(src);
    float e1 = min(hm_pq(m) / maxLum, 1.0);
    float maxT = hm_pq(dst) / maxLum;
    float ks = 1.5 * maxT - 0.5;
    float e2 = e1;
    if (e1 > ks) {
        float t = (e1 - ks) / (1.0 - ks);
        float t2 = t * t, t3 = t2 * t;
        e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * ks
           + (t3 - 2.0 * t2 + t) * (1.0 - ks)
           + (-2.0 * t3 + 3.0 * t2) * maxT;
    }
    return nits * (hm_nits(e2 * maxLum) / m);
}

void main() {
    float y = texture(uY, vUV).r * 64.0615844;
    vec2 uv = texture(uUV, vUV).rg * 64.0615844;
    vec3 pq = clamp(yuv2020(y, uv.x, uv.y), 0.0, 1.0);
    vec3 n = vec3(hm_nits(pq.r), hm_nits(pq.g), hm_nits(pq.b));
    n = hdr_peak_map(n, dv.lohi[0].w, dv.lohi[1].w);
    out_color = vec4(hm_pq(n.r), hm_pq(n.g), hm_pq(n.b), 1.0);
}

[FsInfo]
entryPoint = main

[ResourceMapping]
userDataNode[0].visibility = 2
userDataNode[0].type = DescriptorTableVaPtr
userDataNode[0].offsetInDwords = 0
userDataNode[0].sizeInDwords = 1
userDataNode[0].next[0].type = DescriptorConstBuffer
userDataNode[0].next[0].offsetInDwords = 0
userDataNode[0].next[0].sizeInDwords = 4
userDataNode[0].next[0].set = 0
userDataNode[0].next[0].binding = 0
userDataNode[1].visibility = 64
userDataNode[1].type = DescriptorTableVaPtr
userDataNode[1].offsetInDwords = 0
userDataNode[1].sizeInDwords = 1
userDataNode[1].next[0].type = DescriptorCombinedTexture
userDataNode[1].next[0].offsetInDwords = 0
userDataNode[1].next[0].sizeInDwords = 12
userDataNode[1].next[0].set = 1
userDataNode[1].next[0].binding = 0
userDataNode[1].next[1].type = DescriptorCombinedTexture
userDataNode[1].next[1].offsetInDwords = 12
userDataNode[1].next[1].sizeInDwords = 12
userDataNode[1].next[1].set = 1
userDataNode[1].next[1].binding = 1
userDataNode[1].next[2].type = DescriptorConstBuffer
userDataNode[1].next[2].offsetInDwords = 24
userDataNode[1].next[2].sizeInDwords = 4
userDataNode[1].next[2].set = 1
userDataNode[1].next[2].binding = 2

[GraphicsPipelineState]
topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
nggState.enableNgg = 1
nggState.enableGsUse = 0
; R8G8B8A8 because the shader exports plain RGBA; the BGRA ordering the scanout
; wants is done by COMP_SWAP=ALT in CB_COLOR0_INFO (see evo_agc_runtime.c).
colorBuffer[0].format = VK_FORMAT_R8G8B8A8_UNORM
colorBuffer[0].channelWriteMask = 15
colorBuffer[0].blendEnable = 0
