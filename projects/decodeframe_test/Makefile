# EVO Player - decodeframe_test
#
# Phase 6 of the hardware-decode work: feed sceVideodec2Decode a real H.264
# access unit and ask whether a picture came back.
#
# Kept separate from createdecoder_test so Phase 5's evidence stays
# reproducible on its own, and a dead end here costs nothing there.
#
# LAUNCH IT WITH ./scripts/install-homebrew.sh --run, NOT ./scripts/deploy.sh.
# The 1080p working set is 90 MiB; the elfldr slot caps out below 64.
#
# No -lSceVideodec2: the SDK ships no stub for it. The module is loaded with
# sceKernelLoadStartModule and every entry point resolved by NID at run time.
#
# test_stream.S links test_1080p.h264 into .rodata with .incbin, so the probe
# carries its own bitstream and needs nothing copied onto the console. Both the
# stream and test_stream.h are regenerated by tools/gen-test-stream.sh; neither
# is edited by hand. -I$(CURDIR) is what lets the assembler find the .h264
# alongside the .S regardless of where make was invoked from.

include ../common/evo.mk

ELF  := decodeframe_test.elf
SRCS := main.c test_stream.S $(EVO_COMMON_SRCS)

CFLAGS += -I$(CURDIR)

# NO -lSceVideoOut. Opening video out from this payload kernel-panicked the
# console on 2026-08-11; the library is unlinked so the call cannot come back
# by accident. See the REMOVED block in main.c.
LIBS := -lSceSysmodule -lSceUserService

all: $(ELF)

$(ELF): $(SRCS) test_stream.h test_1080p.h264
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LIBS)

# Regenerate the bitstream and its index. Needs ffmpeg on the host, so it is
# never a build dependency - the generated files are committed.
stream:
	../../tools/gen-test-stream.sh

clean:
	rm -f $(ELF)

.PHONY: stream
