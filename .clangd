# clangd configuration for EVO Player.
#
# compile_commands.json (generated by ./scripts/gen-compile-commands.sh) is the
# real source of truth for include paths and defines. This file only patches
# the few things a compile database cannot express.

CompileFlags:
  # The database is written by the cross build, so the entries already point at
  # prospero-clang. Point clangd at the same driver so it picks up the identical
  # builtin include paths and target triple.
  Compiler: /opt/ps5-payload-sdk/bin/prospero-clang

  Add:
    - -I/opt/ps5-payload-sdk/target/include
    - -I/workspace/projects/common/include
    # The ports prefix (SDL2, FFmpeg headers) supplied by pacbrew-repo.
    - -I/opt/ps5-payload-sdk/target/user/homebrew/include
    - -I/opt/ps5-payload-sdk/target/user/homebrew/include/SDL2

  Remove:
    # prospero-clang injects PS5-specific driver flags that clangd's own
    # argument parser does not recognise; dropping them avoids spurious
    # "unknown argument" diagnostics in the editor.
    - -fno-plt
    - -fvisibility-nodllstorageclass=*

Diagnostics:
  UnusedIncludes: None
  # Sony APIs are declared by hand in projects/common/include/evo_ps5.h; clangd
  # would otherwise suggest adding headers that do not exist.
  MissingIncludes: None

  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - readability-inconsistent-declaration-parameter-name
    Remove:
      # Fires constantly on fixed-size SCE ABI structs and PCM buffers.
      - bugprone-easily-swappable-parameters
      - readability-magic-numbers

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
