diff --git a/src/platform/ps5gl_fatal.h b/src/platform/ps5gl_fatal.h
new file mode 100644
index 0000000..c173780
--- /dev/null
+++ b/src/platform/ps5gl_fatal.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * ps5gl_fatal — recoverable replacement for the driver's _Exit(EXIT_FAILURE)
+ * fail-stop paths.
+ *
+ * EVO Player carries this patch (patches/ps5-opengl/0001-recoverable-fail.patch)
+ * because the app module must never _exit(): it strands the PS5 app slot
+ * (only a PS-button close frees it), loses resume state, and skips teardown.
+ * See EVO's CLAUDE.md ("never _exit() from the app module").
+ *
+ * The weak default below preserves upstream behaviour for a standalone
+ * ps5-opengl build. A consumer (EVO) provides a strong ps5gl_fatal() that
+ * logs the tag and unwinds to a setjmp fence instead of taking the process
+ * down — see projects/evoplayer/pp/src/pp_gl_fatal.c.
+ */
+#ifndef PS5GL_FATAL_H
+#define PS5GL_FATAL_H
+
+#include <stdlib.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+__attribute__((weak, noreturn)) void ps5gl_fatal(const char *tag);
+
+__attribute__((weak, noreturn)) void ps5gl_fatal(const char *tag)
+{
+    (void)tag;
+    _Exit(EXIT_FAILURE);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS5GL_FATAL_H */
